<%- include('partials/header', { title: 'Verifikasi 2FA - PutzPay' }) %>

<div class="min-h-screen sm:min-h-[75vh] flex flex-col items-center justify-center py-5 sm:py-6 px-4">
  
  <div class="w-full max-w-md bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-7 sm:p-9 shadow-sm sm:shadow-card relative animate-fade-in">

    <!-- Header Logo & Title -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 rounded-lg sm:rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center text-xl mx-auto mb-3 shadow-xs">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[11px] font-semibold border border-blue-100 mb-2">
        <i class="fa-solid fa-lock text-[10px]"></i>
        <span>Two-Factor Authentication</span>
      </div>
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight font-outfit">Verifikasi Keamanan 2FA</h2>
      <p class="text-xs text-slate-500 font-sans mt-1">
        Masukkan kode 6 digit dari <strong class="text-slate-800 font-medium">Google Authenticator</strong> untuk melanjutkan ke akun <span class="font-mono font-semibold text-blue-600">@<%= user.username %></span>.
      </p>
    </div>

    <!-- Alert Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-lg sm:rounded-2xl mb-5 text-xs font-semibold flex items-center gap-2 sm:gap-3 shadow-xs">
        <i class="fas fa-exclamation-circle text-rose-600 text-sm shrink-0"></i>
        <p class="leading-snug"><%= error %></p>
      </div>
    <% } %>

    <% if (typeof locked !== 'undefined' && locked) { %>
      <div class="bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-lg sm:rounded-2xl mb-5 text-xs font-semibold flex items-center gap-2 sm:gap-3 shadow-xs">
        <i class="fas fa-clock text-amber-600 text-sm shrink-0"></i>
        <p class="leading-snug">Terlalu banyak percobaan salah. Silakan tunggu <%= remainingSeconds %> detik sebelum mencoba kembali.</p>
      </div>
    <% } %>

    <!-- Form 2FA Standard (TOTP) -->
    <form id="totpForm" method="POST" action="/login/2fa" class="flex flex-col gap-4">
      <input type="hidden" name="isRecovery" id="isRecoveryInput" value="false">

      <div id="totpFieldWrapper">
        <label for="totpInput" class="block text-xs font-semibold text-slate-700 mb-2 text-center">
          Kode 6-Digit Authenticator
        </label>
        <div class="relative flex items-center justify-center">
          <input id="totpInput" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6"
                 placeholder="000000"
                 class="w-full text-center tracking-[0.5em] font-mono text-2xl font-bold py-3.5 px-4 bg-slate-50 border border-slate-300 rounded-lg sm:rounded-2xl text-slate-900 outline-none focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100 transition-all placeholder:text-slate-300"
                 required autofocus autocomplete="one-time-code">
        </div>
        <p class="text-[11px] text-slate-400 text-center mt-2">
          Kode berganti setiap 30 detik di aplikasi Authenticator Anda
        </p>
      </div>

      <!-- Recovery Code Field (hidden by default) -->
      <div id="recoveryFieldWrapper" class="hidden">
        <label for="recoveryInput" class="block text-xs font-semibold text-slate-700 mb-1.5">
          Kode Pemulihan Cadangan (Recovery Code)
        </label>
        <input id="recoveryInput" name="recoveryCode" type="text"
               placeholder="Contoh: A1B2-C3D4"
               class="w-full uppercase font-mono text-center text-base font-semibold py-3 px-4 bg-slate-50 border border-slate-300 rounded-lg sm:rounded-2xl text-slate-900 outline-none focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100 transition-all placeholder:text-slate-300"
               autocomplete="off">
        <p class="text-[11px] text-slate-500 mt-1.5 leading-snug">
          Gunakan salah satu dari 8 kode pemulihan yang Anda simpan saat mengaktifkan 2FA. Setiap kode hanya dapat dipakai 1 kali.
        </p>
      </div>

      <!-- Tombol Verifikasi -->
      <button type="submit" id="submitBtn" class="bg-blue-600 hover:bg-blue-700 text-white w-full py-3.5 rounded-xl text-xs font-bold font-sans uppercase shadow-btn transition-all flex items-center justify-center gap-1.5 sm:gap-2 mt-2 active:scale-95 cursor-pointer">
        <i class="fa-solid fa-shield-check text-xs"></i>
        <span id="submitBtnText">Verifikasi & Masuk</span>
      </button>

      <!-- Toggle Recovery Code -->
      <div class="text-center pt-2">
        <button type="button" id="toggleRecoveryBtn" onclick="toggleRecoveryMode()" class="text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline cursor-pointer bg-transparent border-0 inline-flex items-center gap-1.5">
          <i class="fa-solid fa-key text-[11px]"></i>
          <span id="toggleRecoveryText">Kehilangan akses Authenticator? Gunakan Kode Pemulihan</span>
        </button>
      </div>
    </form>

    <!-- Divider -->
    <div class="my-6 flex items-center justify-center gap-2 sm:gap-3">
      <div class="h-px bg-slate-200 flex-1"></div>
      <span class="text-[11px] font-semibold text-slate-400">ATAU</span>
      <div class="h-px bg-slate-200 flex-1"></div>
    </div>

    <!-- Batal / Ganti Akun -->
    <div class="text-center">
      <a href="/login/2fa/cancel" class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors inline-flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Batalkan dan Masuk dengan Akun Lain</span>
      </a>
    </div>

  </div>

</div>

<script>
  let isRecoveryMode = false;

  function toggleRecoveryMode() {
    isRecoveryMode = !isRecoveryMode;
    const totpWrapper = document.getElementById('totpFieldWrapper');
    const recoveryWrapper = document.getElementById('recoveryFieldWrapper');
    const totpInput = document.getElementById('totpInput');
    const recoveryInput = document.getElementById('recoveryInput');
    const isRecoveryInput = document.getElementById('isRecoveryInput');
    const toggleRecoveryText = document.getElementById('toggleRecoveryText');
    const submitBtnText = document.getElementById('submitBtnText');

    if (isRecoveryMode) {
      totpWrapper.classList.add('hidden');
      recoveryWrapper.classList.remove('hidden');
      totpInput.removeAttribute('required');
      recoveryInput.setAttribute('required', 'required');
      isRecoveryInput.value = 'true';
      toggleRecoveryText.textContent = 'Kembali ke kode Google Authenticator';
      submitBtnText.textContent = 'Verifikasi dengan Kode Cadangan';
      recoveryInput.focus();
    } else {
      recoveryWrapper.classList.add('hidden');
      totpWrapper.classList.remove('hidden');
      recoveryInput.removeAttribute('required');
      totpInput.setAttribute('required', 'required');
      isRecoveryInput.value = 'false';
      toggleRecoveryText.textContent = 'Kehilangan akses Authenticator? Gunakan Kode Pemulihan';
      submitBtnText.textContent = 'Verifikasi & Masuk';
      totpInput.focus();
    }
  }

  // Handle auto-submit on 6-digit TOTP input
  const totpInput = document.getElementById('totpInput');
  if (totpInput) {
    totpInput.addEventListener('input', function(e) {
      // Remove any non-digits
      this.value = this.value.replace(/[^0-9]/g, '');
      if (this.value.length === 6) {
        document.getElementById('totpForm').submit();
      }
    });
  }

  // Handle recovery input formatting
  const recoveryInput = document.getElementById('recoveryInput');
  if (recoveryInput) {
    recoveryInput.addEventListener('input', function(e) {
      this.value = this.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
    });
  }
</script>

<%- include('partials/footer') %>
