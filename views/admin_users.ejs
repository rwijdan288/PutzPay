<script>
  function getUserDataFromRow(row) {
    return {
      id: row.dataset.id,
      username: row.dataset.username,
      email: row.dataset.email,
      balance: row.dataset.balance,
      suspended: row.dataset.suspended === 'true',
      role: row.dataset.role || 'user',
      permissions: row.dataset.permissions ? row.dataset.permissions.split(',') : [],
      ip: row.dataset.ip || '',
      device: row.dataset.device || 'Desktop / Mobile',
      ipbanned: row.dataset.ipbanned === 'true',
      created: row.dataset.created
    };
  }

  function togglePermsSection(role) {
    const permsContainer = document.getElementById('permissionsContainer');
    if (role === 'admin') {
      permsContainer.classList.remove('hidden');
    } else {
      permsContainer.classList.add('hidden');
    }
  }

  function formatEditBalance(input) {
    let raw = input.value.replace(/\D/g, '');
    document.getElementById('editBalanceReal').value = raw;
    input.value = raw ? Number(raw).toLocaleString('id-ID') : '';
  }

  function openEditModalWithData(user) {
    document.getElementById('editUsername').value = user.username;
    document.getElementById('editEmail').value = user.email;
    document.getElementById('editBalanceDisplay').value = Number(user.balance).toLocaleString('id-ID');
    document.getElementById('editBalanceReal').value = user.balance;
    document.getElementById('editSuspended').checked = user.suspended;
    document.getElementById('editUserForm').action = '/admin/users/' + user.id + '/edit';

    const roleSelect = document.getElementById('editUserRole');
    if (roleSelect) {
      roleSelect.value = user.role;
      togglePermsSection(user.role);
    }
    const badge = document.getElementById('currentRoleBadge');
    if (badge) badge.textContent = (user.role || 'USER').toUpperCase();

    const permBoxes = document.querySelectorAll('.perm-checkbox');
    permBoxes.forEach(box => {
      box.checked = user.permissions.includes(box.value);
    });

    const ipEl = document.getElementById('modalUserIp');
    const devEl = document.getElementById('modalUserDevice');
    if (ipEl) ipEl.textContent = user.ip || 'Belum tersedia';
    if (devEl) devEl.textContent = user.device || 'Belum tersedia';

    const modal = document.getElementById('editUserModal');
    const content = document.getElementById('editUserModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeEditUserModal() {
    if (window.location.hash.startsWith('#edit-user-')) {
      history.back();
    } else {
      hideEditModalUI();
    }
  }

  function hideEditModalUI() {
    const modal = document.getElementById('editUserModal');
    const content = document.getElementById('editUserModalContent');
    if (content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  function openDirectBanModal(userId, username) {
    document.getElementById('directBanUsernameInput').value = username;
    document.getElementById('directBanUsernameText').textContent = '@' + username;
    const modal = document.getElementById('directBanModal');
    const content = document.getElementById('directBanContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeDirectBanModal() {
    const modal = document.getElementById('directBanModal');
    const content = document.getElementById('directBanContent');
    if (content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function openQuickBanModal(userId, username, ip) {
    document.getElementById('quickBanUsername').textContent = '@' + username;
    document.getElementById('quickBanIp').value = ip;
    document.getElementById('quickBanForm').action = '/admin/users/' + userId + '/ban-ip';

    const modal = document.getElementById('quickBanModal');
    const content = document.getElementById('quickBanContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeQuickBanModal() {
    const modal = document.getElementById('quickBanModal');
    const content = document.getElementById('quickBanContent');
    if (content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function toggleSelectAllUsers(master) {
    document.querySelectorAll('.user-select-box').forEach(cb => {
      cb.checked = master.checked;
    });
    updateSelectedUsers();
  }

  function updateSelectedUsers() {
    const checked = Array.from(document.querySelectorAll('.user-select-box:checked')).map(cb => cb.value);
    const bulkBar = document.getElementById('bulkActionBar');
    const badge = document.getElementById('selectedCountBadge');
    if (checked.length > 0) {
      bulkBar.classList.remove('hidden');
      badge.textContent = checked.length;
    } else {
      bulkBar.classList.add('hidden');
    }
  }

  function openBulkBanModal() {
    const checked = Array.from(document.querySelectorAll('.user-select-box:checked')).map(cb => cb.value);
    if (checked.length === 0) return;
    document.getElementById('bulkBanUserIdsInput').value = JSON.stringify(checked);
    document.getElementById('bulkBanCountText').textContent = checked.length;
    const modal = document.getElementById('bulkBanModal');
    const content = document.getElementById('bulkBanContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeBulkBanModal() {
    const modal = document.getElementById('bulkBanModal');
    const content = document.getElementById('bulkBanContent');
    if (content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function confirmDeleteUser() {
    const actionParts = document.getElementById('editUserForm').action.split('/');
    const userId = actionParts[actionParts.length - 2];
    if (!userId) return;
    document.getElementById('deleteUserForm').action = '/admin/users/' + userId + '/delete';
    
    const modal = document.getElementById('deleteConfirmModal');
    const content = document.getElementById('deleteConfirmContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeDeleteConfirmModal() {
    const modal = document.getElementById('deleteConfirmModal');
    const content = document.getElementById('deleteConfirmContent');
    if (content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  function handleHashChange() {
    const hash = window.location.hash;
    if (hash.startsWith('#edit-user-')) {
      const userId = hash.replace('#edit-user-', '');
      const row = document.querySelector(`tr.user-row[data-id="${userId}"]`);
      if (row) {
        const user = getUserDataFromRow(row);
        openEditModalWithData(user);
      } else {
        history.replaceState(null, null, window.location.pathname + window.location.search);
      }
    } else {
      hideEditModalUI();
    }
  }

  window.addEventListener('hashchange', handleHashChange);
  window.addEventListener('popstate', function() {
    if (!window.location.hash.startsWith('#edit-user-')) {
      hideEditModalUI();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    if (window.location.hash.startsWith('#edit-user-')) {
      handleHashChange();
    }
  });

  (() => {
    const input = document.getElementById('searchInput');
    if (!input) return;
    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const params = new URLSearchParams(window.location.search);
        if (input.value) params.set('search', input.value);
        else params.delete('search');
        window.location.search = params.toString();
      }, 500);
    });
  })();
</script>

