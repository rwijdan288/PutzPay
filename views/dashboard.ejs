<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-5 md:py-5 sm:py-6 w-full min-w-0 space-y-6">

  <!-- Welcome Header (Real-time Greeting) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-2 pb-1">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Sun/Moon Icon (realtime, "mekar" mengikuti jam) -->
      <div id="greetingIconWrap" class="relative w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center shrink-0">
        <svg id="greetingIcon" viewBox="0 0 100 100" class="w-full h-full transition-all duration-700 ease-out">
          <!-- Rays (matahari) -->
          <g id="sunRays" class="transition-all duration-700 ease-out" style="transform-origin: 50px 50px;">
            <g id="sunRaysGroup">
              <rect x="47" y="2" width="6" height="16" rx="3" fill="currentColor"></rect>
              <rect x="47" y="82" width="6" height="16" rx="3" fill="currentColor"></rect>
              <rect x="82" y="47" width="16" height="6" rx="3" fill="currentColor"></rect>
              <rect x="2" y="47" width="16" height="6" rx="3" fill="currentColor"></rect>
              <rect x="47" y="2" width="6" height="16" rx="3" fill="currentColor" transform="rotate(45 50 50)"></rect>
              <rect x="47" y="82" width="6" height="16" rx="3" fill="currentColor" transform="rotate(45 50 50)"></rect>
              <rect x="82" y="47" width="16" height="6" rx="3" fill="currentColor" transform="rotate(45 50 50)"></rect>
              <rect x="2" y="47" width="16" height="6" rx="3" fill="currentColor" transform="rotate(45 50 50)"></rect>
            </g>
          </g>
          <!-- Sun core -->
          <circle id="sunCore" cx="50" cy="50" r="22" fill="currentColor" class="transition-all duration-700 ease-out"></circle>
          <!-- Moon (malam) -->
          <path id="moonShape" d="M 65 20 A 32 32 0 1 0 65 80 A 25 25 0 1 1 65 20 Z" fill="currentColor" class="transition-all duration-700 ease-out opacity-0"></path>
          <!-- Stars (malam) -->
          <g id="nightStars" class="transition-opacity duration-700 ease-out opacity-0">
            <circle cx="18" cy="22" r="2.5" fill="currentColor"></circle>
            <circle cx="80" cy="18" r="1.8" fill="currentColor"></circle>
            <circle cx="85" cy="58" r="2" fill="currentColor"></circle>
          </g>
        </svg>
      </div>
      <div>
        <h1 id="greetingText" class="text-base sm:text-lg lg:text-xl lg:text-2xl font-black text-slate-900 font-outfit tracking-tight">
          Selamat datang, <%= user.name || user.username %> 👋
        </h1>
        <p class="text-xs text-slate-500 font-sans mt-0.5">Kelola pembayaran QRIS otomatis dan pantau arus kas Anda.</p>
      </div>
    </div>
    <div class="flex items-center gap-1.5 sm:gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Akun Terverifikasi
      </span>
    </div>
  </div>

  <script>
    (function() {
      const userName = <%- JSON.stringify(user.name || user.username || '') %>;

      function updateGreeting() {
        const now = new Date();
        const hour = now.getHours() + now.getMinutes() / 60;

        const textEl = document.getElementById('greetingText');
        const sunCore = document.getElementById('sunCore');
        const sunRays = document.getElementById('sunRays');
        const moonShape = document.getElementById('moonShape');
        const stars = document.getElementById('nightStars');
        const iconWrap = document.getElementById('greetingIconWrap');
        if (!textEl || !sunCore || !moonShape) return;

        let greeting, bloom, sunColor, isNight;

        if (hour >= 4 && hour < 11) {
          // PAGI (04:00 - 10:59) - matahari terbit, mekar bertahap dari kecil ke penuh
          greeting = 'Selamat pagi';
          bloom = Math.min(1, (hour - 4) / (11 - 4));
          sunColor = '#f59e0b'; // amber (pagi hangat)
          isNight = false;
        } else if (hour >= 11 && hour < 15) {
          // SIANG (11:00 - 14:59) - matahari mekar penuh & terang
          greeting = 'Selamat siang';
          bloom = 1;
          sunColor = '#eab308'; // kuning terang
          isNight = false;
        } else if (hour >= 15 && hour < 18) {
          // SORE (15:00 - 17:59) - matahari mulai redup menuju terbenam
          greeting = 'Selamat sore';
          bloom = Math.max(0.35, 1 - (hour - 15) / (18 - 15));
          sunColor = '#f97316'; // oranye senja
          isNight = false;
        } else {
          // MALAM (18:00 - 03:59) - bulan & bintang
          greeting = 'Selamat malam';
          bloom = 0;
          sunColor = '#f59e0b';
          isNight = true;
        }

        textEl.innerHTML = greeting + ', <span class="text-slate-900">' + (userName || 'Pengguna') + '</span> 👋';

        if (isNight) {
          sunCore.style.opacity = '0';
          sunRays.style.opacity = '0';
          moonShape.style.opacity = '1';
          moonShape.style.color = '#cbd5e1';
          stars.style.opacity = '1';
          stars.style.color = '#fde68a';
          iconWrap.style.color = '#64748b';
        } else {
          moonShape.style.opacity = '0';
          stars.style.opacity = '0';
          sunCore.style.opacity = '1';
          sunRays.style.opacity = String(bloom);
          // "Mekar": skala inti + jarak sinar mengikuti bloom (0.55 -> 1.0)
          const scale = 0.55 + (0.45 * bloom);
          sunCore.setAttribute('r', String(14 + 8 * bloom));
          sunRays.style.transform = 'scale(' + scale + ')';
          sunCore.style.color = sunColor;
          sunRays.style.color = sunColor;
        }
      }

      updateGreeting();
      // Update tiap 1 menit supaya tetap realtime tanpa perlu reload halaman
      setInterval(updateGreeting, 60 * 1000);
    })();
  </script>

  <!-- Primary Balance Card (Modern Fintech Slate Card) -->
