              <span class="text-xs sm:text-sm text-amber-400">Rp</span><span id="pendingBalanceValue"><%= (typeof pendingBalance !== 'undefined' ? pendingBalance : 0).toLocaleString('id-ID') %></span>
            </h3>
            <h3 id="pendingHidden" class="text-base sm:text-lg lg:text-xl font-bold text-amber-300 font-outfit hidden leading-none">
