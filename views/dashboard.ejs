</div>

<script>
  let nextReleaseTime = <%= (typeof nextReleaseAt !== 'undefined' && nextReleaseAt) ? new Date(nextReleaseAt).getTime() : 0 %>;
  let currentPendingBalance = <%= typeof pendingBalance !== 'undefined' ? pendingBalance : 0 %>;

  function toggleBalance() {
    const real = document.getElementById('balanceReal');
    const hidden = document.getElementById('balanceHidden');
    const usdReal = document.getElementById('balanceUsdReal');
    const usdHidden = document.getElementById('balanceUsdHidden');

    const pendingReal = document.getElementById('pendingReal');
    const pendingHidden = document.getElementById('pendingHidden');
    const pendingUsdReal = document.getElementById('pendingUsdReal');
    const pendingUsdHidden = document.getElementById('pendingUsdHidden');

    const icon = document.getElementById('balanceEyeIcon');

    if (real) real.classList.toggle('hidden');
    if (hidden) hidden.classList.toggle('hidden');
    if (usdReal) usdReal.classList.toggle('hidden');
    if (usdHidden) usdHidden.classList.toggle('hidden');

    if (pendingReal) pendingReal.classList.toggle('hidden');
    if (pendingHidden) pendingHidden.classList.toggle('hidden');
    if (pendingUsdReal) pendingUsdReal.classList.toggle('hidden');
    if (pendingUsdHidden) pendingUsdHidden.classList.toggle('hidden');

    if (icon) {
      icon.classList.toggle('fa-eye');
      icon.classList.toggle('fa-eye-slash');
    }
  }

  function updatePendingCountdown() {
    const box = document.getElementById('pendingCountdownBox');
    const textEl = document.getElementById('pendingCountdownText');

    if (currentPendingBalance <= 0 || !nextReleaseTime || nextReleaseTime <= 0) {
      if (box) {
        box.classList.add('hidden');
        box.classList.remove('inline-flex');
      }
      return;
    }

    const now = Date.now();
    const diffMs = nextReleaseTime - now;

    if (diffMs <= 0) {
      if (textEl) textEl.textContent = '00j 00m';
      fetchBalanceStatus();
      return;
    }

    if (box) {
      box.classList.remove('hidden');
      box.classList.add('inline-flex');
    }

    const totalMinutes = Math.floor(diffMs / (1000 * 60));
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;

    const hoursStr = String(hours).padStart(2, '0');
    const minutesStr = String(minutes).padStart(2, '0');

    if (textEl) {
      textEl.textContent = `${hoursStr}j ${minutesStr}m`;
    }
  }

  async function fetchBalanceStatus() {
    try {
      const res = await fetch('/api/user/balance-status');
      const data = await res.json();
      if (data.success) {
        const activeBalVal = document.getElementById('activeBalanceValue');
        const balanceUsdRealEl = document.getElementById('balanceUsdReal');
        if (activeBalVal) {
          activeBalVal.textContent = data.balance.toLocaleString('id-ID');
        }
        if (balanceUsdRealEl) {
          const usdVal = (data.balance / 16000).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          balanceUsdRealEl.textContent = `≈ $${usdVal}`;
        }

        currentPendingBalance = data.pendingBalance || 0;
        nextReleaseTime = data.nextReleaseAt ? new Date(data.nextReleaseAt).getTime() : 0;

        const pendingValEl = document.getElementById('pendingBalanceValue');
        const pendingUsdValEl = document.getElementById('pendingUsdValue');
        if (pendingValEl) {
          pendingValEl.textContent = currentPendingBalance.toLocaleString('id-ID');
        }
        if (pendingUsdValEl) {
          const pUsdVal = (currentPendingBalance / 16000).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          pendingUsdValEl.textContent = pUsdVal;
        }

        updatePendingCountdown();
      }
    } catch (err) {
      console.error('Error fetching balance status:', err);
    }
  }

  setInterval(updatePendingCountdown, 1000);
  setInterval(fetchBalanceStatus, 15000);
  updatePendingCountdown();
</script>

<%- include('partials/footer') %>
