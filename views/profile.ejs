<%- include('partials/header', { title: 'Profil Saya' }) %>

<div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-5 md:py-5 sm:py-6 w-full min-w-0 space-y-6">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-lg sm:rounded-2xl text-xs font-semibold flex items-center gap-2 sm:gap-3 shadow-xs">
      <i class="fa-solid fa-circle-check text-emerald-600 text-sm shrink-0"></i>
      <p><%= success %></p>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-lg sm:rounded-2xl text-xs font-semibold flex items-center gap-2 sm:gap-3 shadow-xs">
      <i class="fa-solid fa-circle-exclamation text-rose-600 text-sm shrink-0"></i>
      <p><%= error %></p>
    </div>
  <% } %>

  <!-- Page Title Header -->
  <div>
    <h1 class="text-base sm:text-lg lg:text-xl lg:text-2xl font-black text-slate-900 tracking-tight font-outfit">Pengaturan Profil & Akun</h1>
    <p class="text-xs text-slate-500 font-sans mt-0.5">Kelola identitas akun, kredensial API, dan informasi rekening pencairan dana Anda.</p>
  </div>

  <!-- Avatar & User Header Card -->
  <div class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center items-center gap-5 sm:gap-6">
      <div class="relative shrink-0">
        <div id="avatarContainer" class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 rounded-lg sm:rounded-2xl overflow-hidden border border-slate-200 shadow-xs">
          <% if (user.profilePicture) { %>
            <img src="<%= user.profilePicture %>" alt="Foto Profil" class="w-full h-full object-cover" id="profileImagePreview">
          <% } else { %>
            <div id="profileInitial" class="w-full h-full flex items-center justify-center text-white text-base sm:text-lg lg:text-xl lg:text-2xl lg:text-3xl font-black font-outfit bg-gradient-to-tr from-blue-600 to-indigo-600" style="<%= user.profileColor ? 'background:' + user.profileColor : '' %>">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          <% } %>
        </div>
        <label for="profileImageInput" class="absolute -bottom-1 -right-1 w-8 h-8 bg-blue-600 hover:bg-blue-700 text-white rounded-xl flex items-center justify-center cursor-pointer shadow-btn active:scale-95 transition-all border-2 border-white" title="Ganti Foto">
          <i class="fas fa-camera text-xs"></i>
        </label>
        <input type="file" id="profileImageInput" accept="image/*" class="hidden" />
      </div>

      <div class="text-center sm:text-left lg:text-left flex-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-semibold border border-blue-100 mb-2">
          <i class="fa-solid fa-shield-halved text-xs"></i>
          <span>Pengguna Terverifikasi</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900 font-outfit"><%= user.username %></h2>
        <p class="text-xs text-slate-500 font-sans mt-0.5"><%= user.email %></p>
        <p id="uploadStatus" class="text-xs font-medium text-slate-600 mt-2 hidden"></p>
      </div>
    </div>
  </div>

  <% 
    let is2FaActive = !!(user && user.twoFactorEnabled);
    let rawApiKey = '';
    if (is2FaActive && typeof apiKeys !== 'undefined' && apiKeys.length > 0) {
      rawApiKey = apiKeys[0].key;
    }
  %>

  <!-- Informasi Akun Section -->
  <div class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900 font-outfit">Informasi Data Akun</h2>
        <p class="text-xs text-slate-500 font-sans mt-0.5">Informasi utama akun & akses API merchant integration.</p>
      </div>
      <button onclick="openEditInfoModal()" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-xs font-bold font-sans shadow-btn active:scale-95 transition-all cursor-pointer shrink-0">
        <i class="fas fa-pen-to-square text-xs"></i>
        <span>Edit Informasi</span>
      </button>
    </div>

    <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden shadow-xs">
      <table class="w-full text-xs text-left divide-y divide-slate-100 font-sans text-slate-800">
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Nama Lengkap</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900"><%= user.fullName || user.googleName || '-' %></td>
          </tr>
          <tr>
            <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Username</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900 font-mono"><%= user.username %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Alamat Email</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900"><%= user.email %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Telegram ID</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900"><%= user.telegramId || '-' %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Nomor WhatsApp/HP</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900"><%= user.phoneNumber || '-' %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">API Key Merchant</td>
            <td class="py-3 px-4 sm:px-5 font-mono font-semibold text-slate-900">
              <% if (!is2FaActive) { %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-2 py-0.5">
                  <div class="flex items-center gap-1.5 sm:gap-2 text-rose-600 font-sans text-xs">
                    <i class="fa-solid fa-lock text-rose-500"></i>
                    <span>Terkunci &mdash; Aktifkan 2FA terlebih dahulu untuk mendapatkan API Key</span>
                  </div>
                  <a href="#keamanan-2fa" class="text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg px-2.5 py-1 text-xs font-semibold shrink-0 transition-colors w-fit font-sans">
                    Aktifkan 2FA
                  </a>
                </div>
              <% } else { %>
                <div class="flex items-center justify-between gap-1.5 sm:gap-2">
                  <span id="tableApiKeyDisplay" class="truncate max-w-[200px] sm:max-w-md"><%= rawApiKey ? '••••••••••••••••' : 'Belum ada API Key' %></span>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <% if (rawApiKey) { %>
                      <button type="button" onclick="promptApiKey2FaAction('reveal')" class="text-slate-700 bg-slate-100 border border-slate-200 rounded-lg px-2.5 py-1 text-xs hover:bg-slate-200 transition-colors cursor-pointer flex items-center gap-1 font-semibold" title="Tampilkan / Sembunyikan API Key">
                        <i id="tableApiKeyIcon" class="far fa-eye text-xs"></i>
                        <span id="tableApiKeyBtnText" class="text-[11px]">Lihat</span>
                      </button>
                      <button type="button" onclick="promptApiKey2FaAction('regenerate')" class="text-blue-700 bg-blue-50 border border-blue-200 rounded-lg px-2.5 py-1 text-xs hover:bg-blue-100 transition-colors cursor-pointer flex items-center gap-1 font-semibold" title="Generate Ulang API Key">
                        <i class="fa-solid fa-arrows-rotate text-[10px]"></i>
                        <span class="text-[11px]">Ganti</span>
                      </button>
                    <% } else { %>
                      <button type="button" onclick="promptApiKey2FaAction('create')" class="text-blue-700 bg-blue-50 border border-blue-200 rounded-lg px-2.5 py-1 text-xs hover:bg-blue-100 transition-colors cursor-pointer flex items-center gap-1 font-semibold">
                        <i class="fa-solid fa-plus text-[10px]"></i>
                        <span class="text-[11px]">Buat API Key</span>
                      </button>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ==================== PENGATURAN KEAMANAN & 2FA ==================== -->
  <div id="keamanan-2fa" class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs space-y-5 scroll-mt-24">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-1.5 sm:gap-2.5 flex-wrap">
          <h2 class="text-base font-bold text-slate-900 font-outfit">Keamanan & Two-Factor Authentication (2FA)</h2>
          <% if (is2FaActive) { %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>🟢 2FA Aktif</span>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              <span>🔴 2FA Belum Aktif</span>
            </span>
          <% } %>
        </div>
        <p class="text-xs text-slate-500 font-sans mt-1">
          Pengaturan autentikasi dua faktor berbasis waktu (TOTP) standar Google Authenticator untuk keamanan akun dan akses API.
        </p>
      </div>

      <div>
        <% if (!is2FaActive) { %>
          <button type="button" onclick="open2FaSetupModal()" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-xs font-bold font-sans shadow-btn active:scale-95 transition-all cursor-pointer">
            <i class="fa-solid fa-shield-halved text-xs"></i>
            <span>Aktifkan 2FA</span>
          </button>
        <% } else { %>
          <button type="button" onclick="open2FaDisableModal()" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-4 py-2.5 rounded-xl text-xs font-bold font-sans active:scale-95 transition-all cursor-pointer">
            <i class="fa-solid fa-shield-xmark text-xs"></i>
            <span>Nonaktifkan 2FA</span>
          </button>
        <% } %>
      </div>
    </div>

    <% if (!is2FaActive) { %>
      <div class="bg-amber-50/70 border border-amber-200 rounded-lg sm:rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-2 sm:gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
            <i class="fa-solid fa-triangle-exclamation text-sm"></i>
          </div>
          <div class="text-xs font-sans text-amber-900 leading-relaxed">
            <p class="font-bold text-slate-900">🔒 Aktifkan 2FA terlebih dahulu untuk mendapatkan API Key.</p>
            <p class="text-slate-600 mt-0.5">
              Untuk melindungi dana dan data transaksi Anda, PutzPay menerapkan standar keamanan tinggi: setiap akun wajib mengaktifkan <strong>Google Authenticator (TOTP)</strong> untuk dapat membuat dan menggunakan API Key.
            </p>
          </div>
        </div>
        <button type="button" onclick="open2FaSetupModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-xs font-bold font-sans shrink-0 shadow-btn transition-all cursor-pointer">
          Aktifkan 2FA Sekarang
        </button>
      </div>
    <% } else { %>
      <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden shadow-xs">
        <table class="w-full text-xs text-left divide-y divide-slate-100 font-sans text-slate-800">
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Metode Verifikasi</td>
              <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900 flex items-center gap-1.5 sm:gap-2">
                <i class="fa-brands fa-google text-blue-600"></i>
                <span>TOTP (Google Authenticator)</span>
              </td>
            </tr>
            <tr>
              <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Status Proteksi</td>
              <td class="py-3 px-4 sm:px-5 font-semibold text-emerald-700">
                <i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> Aktif untuk Login & Kredensial API Key
              </td>
            </tr>
            <tr>
              <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Waktu Diaktifkan</td>
              <td class="py-3 px-4 sm:px-5 font-medium text-slate-700">
                <%= user.twoFactorEnabledAt ? new Date(user.twoFactorEnabledAt).toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' }) : 'Sudah Aktif' %>
              </td>
            </tr>
            <tr>
              <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Kode Pemulihan Cadangan</td>
              <td class="py-3 px-4 sm:px-5 font-medium text-slate-700">
                <span class="font-bold text-slate-900"><%= typeof activeRecoveryCount !== 'undefined' ? activeRecoveryCount : 8 %></span> dari <%= typeof totalRecoveryCount !== 'undefined' ? totalRecoveryCount : 8 %> kode cadangan tersisa
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- ==================== WEBHOOK MERCHANT ==================== -->
  <div id="webhook-merchant" class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs space-y-5 scroll-mt-24">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
      <div>
        <h3 class="text-sm sm:text-base font-bold text-slate-900 font-outfit flex items-center gap-2">
          <i class="fa-solid fa-satellite-dish text-blue-600"></i> Webhook Merchant
        </h3>
        <p class="text-xs text-slate-500 font-sans mt-1 max-w-lg">Terima notifikasi otomatis ke server Anda setiap kali ada pembayaran QRIS yang berhasil (event <code class="bg-slate-100 px-1 py-0.5 rounded text-[11px] font-mono">invoice.paid</code>), tanpa perlu polling API berulang kali.</p>
      </div>
      <label class="inline-flex items-center gap-2 cursor-pointer select-none shrink-0">
        <span class="text-xs font-semibold text-slate-600">Aktif</span>
        <span class="relative">
          <input type="checkbox" id="webhookEnabledToggle" class="sr-only peer">
          <span class="block w-10 h-5.5 h-6 bg-slate-300 peer-checked:bg-emerald-500 rounded-full transition-all"></span>
          <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all peer-checked:translate-x-4"></span>
        </span>
      </label>
    </div>

    <!-- URL Webhook -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1.5">URL Endpoint Webhook</label>
      <div class="flex flex-col sm:flex-row gap-2">
        <input id="webhookUrlInput" type="url" placeholder="https://tokoanda.com/callback/putzpay"
               class="flex-1 bg-white border border-slate-300 rounded-lg sm:rounded-xl px-3 sm:px-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400">
        <button id="webhookSaveBtn" onclick="saveWebhookConfig()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg sm:rounded-xl text-xs font-bold shadow-btn transition-all active:scale-95 shrink-0">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Simpan
        </button>
      </div>
      <p id="webhookConfigStatus" class="mt-1.5 text-[11px] font-mono min-h-[16px]"></p>
    </div>

    <!-- Signing Secret -->
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1.5">Signing Secret (untuk verifikasi HMAC-SHA256)</label>
      <div class="flex items-center gap-2">
        <input id="webhookSecretInput" type="password" readonly value="••••••••••••••••••••••••••••"
               class="flex-1 bg-slate-50 border border-slate-300 rounded-lg sm:rounded-xl px-3 sm:px-4 py-2.5 text-xs font-mono font-medium text-slate-700">
        <button type="button" onclick="toggleWebhookSecretVisibility()" id="webhookSecretToggleBtn" class="w-10 h-10 rounded-lg sm:rounded-xl border border-slate-300 text-slate-500 hover:text-slate-800 hover:bg-slate-50 flex items-center justify-center shrink-0 transition-all">
          <i class="fa-solid fa-eye text-xs"></i>
        </button>
        <button type="button" onclick="copyWebhookSecret()" class="w-10 h-10 rounded-lg sm:rounded-xl border border-slate-300 text-slate-500 hover:text-slate-800 hover:bg-slate-50 flex items-center justify-center shrink-0 transition-all">
          <i class="fa-solid fa-copy text-xs"></i>
        </button>
      </div>
      <div class="flex items-center justify-between mt-1.5">
        <p class="text-[11px] text-slate-400 font-sans">Header dikirim: <code class="bg-slate-100 px-1 py-0.5 rounded font-mono">X-PutzPay-Signature</code></p>
        <button type="button" onclick="regenerateWebhookSecret()" class="text-[11px] font-semibold text-rose-600 hover:underline">Generate Ulang Secret</button>
      </div>
    </div>

    <!-- Tombol Test -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 pt-1">
      <button onclick="testWebhook()" id="webhookTestBtn" class="bg-slate-800 hover:bg-slate-900 text-white px-4 py-2.5 rounded-lg sm:rounded-xl text-xs font-bold shadow-btn transition-all active:scale-95 flex items-center justify-center gap-2">
        <i class="fa-solid fa-paper-plane text-xs"></i> Kirim Uji Coba Webhook
      </button>
      <p id="webhookTestResult" class="text-[11px] font-mono"></p>
    </div>

    <!-- Riwayat Pengiriman -->
    <div class="pt-3 border-t border-slate-100">
      <div class="flex items-center justify-between mb-2.5">
        <h4 class="text-xs font-bold text-slate-700">Riwayat Pengiriman Terakhir</h4>
        <button onclick="loadWebhookLogs()" class="text-[11px] font-semibold text-blue-600 hover:underline"><i class="fa-solid fa-rotate-right mr-1"></i>Refresh</button>
      </div>
      <div id="webhookLogsContainer" class="space-y-2 max-h-72 overflow-y-auto pr-1">
        <p class="text-[11px] text-slate-400 font-sans py-4 text-center">Memuat riwayat webhook...</p>
      </div>
    </div>
  </div>

  <!-- Data Pencairan (E-Wallet / Rekening Bank) -->
  <div class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900 font-outfit">Data Pencairan Dana (E-Wallet / Rekening)</h2>
        <p class="text-xs text-slate-500 font-sans mt-0.5">Tujuan transfer saat pengajuan pencairan saldo.</p>
      </div>
      <button onclick="openEditWalletModal()" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-xl text-xs font-bold font-sans shadow-btn active:scale-95 transition-all cursor-pointer shrink-0">
        <i class="fas fa-pen-to-square text-xs"></i>
        <span>Edit Rekening</span>
      </button>
    </div>

    <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden shadow-xs">
      <table class="w-full text-xs text-left divide-y divide-slate-100 font-sans text-slate-800">
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="w-1/3 py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Metode Pencairan</td>
            <td class="py-3 px-4 sm:px-5 font-bold text-slate-900 uppercase"><%= user.ewallet || '-' %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Nomor Rekening / Akun</td>
            <td class="py-3 px-4 sm:px-5 font-mono font-bold text-blue-600"><%= user.accountNumber || '-' %></td>
          </tr>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Atas Nama Pemilik Rekening</td>
            <td class="py-3 px-4 sm:px-5 font-semibold text-slate-900 uppercase"><%= user.accountName || '-' %></td>
          </tr>
          <% 
            let currentFee = 0;
            if (typeof settings !== 'undefined' && settings.withdrawMethods && settings.withdrawMethods.length > 0) {
              const found = settings.withdrawMethods.find(m => m.name === user.ewallet);
              if (found) currentFee = found.fee || 0;
            }
          %>
          <tr>
            <td class="py-3 px-4 sm:px-5 text-slate-500 bg-slate-50 font-medium">Biaya Admin Penarikan</td>
            <td class="py-3 px-4 sm:px-5 font-bold text-slate-900 font-outfit">Rp <%= currentFee.toLocaleString('id-ID') %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Notification Settings Card -->
  <div class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
          <h2 class="text-base font-bold text-slate-900 font-outfit">Notifikasi Web Push</h2>
          <span id="profilePushBadge" class="text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200 px-2.5 py-0.5 rounded-full">
            <span id="pushNotifStatusText">Memeriksa...</span>
          </span>
        </div>
        <p class="text-xs text-slate-500 font-sans mt-0.5">Atur preferensi event notifikasi yang ingin dikirimkan ke perangkat Anda.</p>
