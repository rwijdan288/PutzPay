          <i class="fa-solid fa-bell text-xs"></i>
          <span>Aktifkan Notifikasi</span>
        </button>
        <button id="pushNotifDisableBtn" onclick="PutzPush.unsubscribe()" class="hidden inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-rose-600 hover:bg-rose-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold font-sans shadow-btn active:scale-95 transition-all cursor-pointer">
          <i class="fa-solid fa-bell-slash text-xs"></i>
          <span>Matikan Notifikasi</span>
