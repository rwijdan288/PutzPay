        <button id="pushNotifTestBtn" onclick="PutzPush.sendTestNotification()" class="hidden inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-3.5 py-2 rounded-xl text-xs font-semibold font-sans active:scale-95 transition-all cursor-pointer">
          <i class="fa-solid fa-paper-plane text-xs"></i>
          <span>Kirim Test</span>
