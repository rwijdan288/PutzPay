<%- include('partials/header', { title: 'Buat Password Baru' }) %>

<div class="min-h-screen sm:min-h-[75vh] flex flex-col items-center justify-center py-5 sm:py-6 px-4">
  
  <div class="w-full max-w-md bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-7 sm:p-9 shadow-sm sm:shadow-card relative">

    <!-- Header Logo & Title -->
    <div class="text-center mb-8">
      <% if (settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="Logo" class="w-14 h-14 rounded-lg sm:rounded-2xl object-cover mx-auto mb-4 border border-slate-200 shadow-xs p-1 bg-slate-50">
      <% } else { %>
        <div class="w-14 h-14 rounded-lg sm:rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mx-auto mb-4">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
      <% } %>
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight font-outfit">Buat Password Baru</h2>
      <p class="text-xs text-slate-500 mt-1 font-sans">Silakan masukkan kata sandi baru untuk mengamankan akun Anda</p>
    </div>

    <!-- Alert Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg sm:rounded-2xl mb-6 text-xs font-medium flex items-center gap-2 sm:gap-3">
        <div class="w-6 h-6 rounded-lg bg-rose-100 flex items-center justify-center shrink-0 text-rose-600">
          <i class="fas fa-exclamation-circle text-xs"></i>
        </div>
        <p class="leading-snug"><%= error %></p>
      </div>
    <% } %>

    <!-- Form Reset Password -->
    <form method="POST" action="/reset-password/<%= typeof token !== 'undefined' ? token : '' %>" class="flex flex-col gap-4">
      
      <!-- Password Baru -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5 px-1 font-sans">Password Baru</label>
        <div class="relative flex items-center">
          <span class="absolute left-3.5 text-slate-400 text-xs pointer-events-none"><i class="fa-solid fa-lock"></i></span>
          <input id="passwordInput1" name="password" type="password" placeholder="••••••••" 
                 class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-11 py-3 text-xs font-sans text-slate-900 outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all placeholder:text-slate-400" required>
          <button type="button" onclick="togglePassword('passwordInput1', 'toggleIcon1')" class="absolute right-3.5 w-8 h-8 text-slate-400 hover:text-slate-700 transition-colors flex items-center justify-center cursor-pointer" aria-label="Tampilkan atau sembunyikan password">
            <span id="toggleIcon1" class="flex items-center justify-center">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
          </button>
        </div>
      </div>
      
      <!-- Konfirmasi Password -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5 px-1 font-sans">Konfirmasi Password Baru</label>
        <div class="relative flex items-center">
          <span class="absolute left-3.5 text-slate-400 text-xs pointer-events-none"><i class="fa-solid fa-lock"></i></span>
          <input id="passwordInput2" name="confirmPassword" type="password" placeholder="••••••••" 
                 class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-11 py-3 text-xs font-sans text-slate-900 outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all placeholder:text-slate-400" required>
          <button type="button" onclick="togglePassword('passwordInput2', 'toggleIcon2')" class="absolute right-3.5 w-8 h-8 text-slate-400 hover:text-slate-700 transition-colors flex items-center justify-center cursor-pointer" aria-label="Tampilkan atau sembunyikan password">
            <span id="toggleIcon2" class="flex items-center justify-center">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
          </button>
        </div>
      </div>

      <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white w-full py-3.5 rounded-xl text-xs font-semibold font-outfit shadow-btn transition-all flex items-center justify-center gap-1.5 sm:gap-2 mt-2 active:scale-95 cursor-pointer">
        Simpan Password Baru <i class="fas fa-check text-xs"></i>
      </button>
    </form>
  </div>
</div>

<script>
  function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const iconContainer = document.getElementById(iconId);
    if (!input || !iconContainer) return;
    
    if (input.type === 'password') {
      input.type = 'text';
      iconContainer.innerHTML = `
        <svg class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
          <line x1="1" y1="1" x2="23" y2="23"></line>
        </svg>
      `;
    } else {
      input.type = 'password';
      iconContainer.innerHTML = `
        <svg class="w-3 h-3 sm:w-4 sm:h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      `;
    }
  }
</script>

<%- include('partials/footer') %>
