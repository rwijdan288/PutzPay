<script>
  function switchAccessTab(tabName) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('bg-white', 'text-blue-600', 'shadow-xs', 'border', 'border-slate-200');
      btn.classList.add('bg-transparent', 'text-slate-600');
    });

    const targetPanel = document.getElementById('tabContent-' + tabName);
    const targetBtn = document.getElementById('tabBtn-' + tabName);
    if (targetPanel) targetPanel.classList.remove('hidden');
    if (targetBtn) {
      targetBtn.classList.remove('bg-transparent', 'text-slate-600');
      targetBtn.classList.add('bg-white', 'text-blue-600', 'shadow-xs', 'border', 'border-slate-200');
    }

    const url = new URL(window.location);
    url.searchParams.set('tab', tabName);
    window.history.replaceState({}, '', url);
  }

  function filterUserTable(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.user-ban-row');
    rows.forEach(row => {
      const u = row.dataset.username || '';
      const e = row.dataset.email || '';
      if (!q || u.includes(q) || e.includes(q)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function filterDeviceTable(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.device-row');
    rows.forEach(row => {
      const ip = (row.dataset.ip || '').toLowerCase();
      const dev = (row.dataset.device || '').toLowerCase();
      const u = (row.dataset.username || '').toLowerCase();
      const r = (row.dataset.reason || '').toLowerCase();
      if (!q || ip.includes(q) || dev.includes(q) || u.includes(q) || r.includes(q)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function copyToClipboard(text) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      alert('Alamat IP ' + text + ' berhasil disalin!');
    }).catch(() => {});
  }

  function openGlobalBlockModal() {
    switchAccessTab('global');
    window.scrollTo({ top: 300, behavior: 'smooth' });
  }

  function openBanUserModal() {
    const modal = document.getElementById('banUserModal');
    const content = document.getElementById('banUserModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeBanUserModal() {
    const modal = document.getElementById('banUserModal');
    const content = document.getElementById('banUserModalContent');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  function openAddDeviceBanModal() {
    const modal = document.getElementById('addDeviceBanModal');
    const content = document.getElementById('addDeviceBanModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeAddDeviceBanModal() {
    const modal = document.getElementById('addDeviceBanModal');
    const content = document.getElementById('addDeviceBanModalContent');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  function openBanByUsernameModal() {
    const modal = document.getElementById('banByUsernameModal');
    const content = document.getElementById('banByUsernameModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeBanByUsernameModal() {
    const modal = document.getElementById('banByUsernameModal');
    const content = document.getElementById('banByUsernameModalContent');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }
</script>

