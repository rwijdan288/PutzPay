<%- include('partials/header', { title: 'Verifikasi Email OTP' }) %>

<div class="min-h-screen sm:min-h-[75vh] flex flex-col items-center justify-center py-5 sm:py-6 px-4 font-sans">
  
  <div class="w-full max-w-md bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-7 sm:p-9 shadow-sm sm:shadow-card relative">

    <!-- Header Logo & Title -->
    <div class="text-center mb-6">
      <% if (settings && settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="Logo" class="w-14 h-14 rounded-lg sm:rounded-2xl object-cover mx-auto mb-4 border border-slate-200 shadow-xs p-1 bg-slate-50">
      <% } else { %>
        <div class="w-14 h-14 rounded-lg sm:rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mx-auto mb-4">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
      <% } %>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 border border-blue-200/60 rounded-full text-[10px] font-semibold uppercase text-blue-700 font-mono mb-2">
        <i class="fa-solid fa-envelope-circle-check text-xs"></i> VERIFIKASI KEAMANAN
      </div>
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight font-outfit">Verifikasi Email</h2>
      <p class="text-xs text-slate-500 mt-1 font-sans">
        Kode OTP telah dikirim ke:
      </p>
      <div class="mt-1.5 inline-block bg-slate-50 border border-slate-200 px-3 py-1 rounded-xl text-xs font-mono font-semibold text-blue-600">
        <%= typeof email !== 'undefined' ? email : 'email@anda.com' %>
      </div>
    </div>

    <!-- Alert Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg sm:rounded-2xl mb-6 text-xs font-medium flex items-center gap-2 sm:gap-3">
        <div class="w-6 h-6 rounded-lg bg-rose-100 flex items-center justify-center shrink-0 text-rose-600">
          <i class="fas fa-exclamation-circle text-xs"></i>
        </div>
        <p class="leading-snug"><%= error %></p>
      </div>
    <% } %>
    
    <!-- Alert Success -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg sm:rounded-2xl mb-6 text-xs font-medium flex items-center gap-2 sm:gap-3">
        <div class="w-6 h-6 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 text-emerald-600">
          <i class="fas fa-check-circle text-xs"></i>
        </div>
        <p class="leading-snug"><%= success %></p>
      </div>
    <% } %>

    <!-- Form Verifikasi OTP -->
    <form method="POST" action="/verify-otp" id="otpForm" class="flex flex-col gap-5">
      
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2 text-center">
          Masukkan 6 Digit Kode OTP
        </label>
        
        <!-- 6-Digit OTP Inputs Grid -->
        <div class="grid grid-cols-6 gap-2 sm:gap-1.5 sm:gap-2.5 max-w-[320px] mx-auto" id="otpInputsContainer">
          <% for(let i = 0; i < 6; i++) { %>
            <input type="text" 
                   maxlength="1" 
                   inputmode="numeric" 
                   pattern="[0-9]*" 
                   class="otp-digit w-full h-12 sm:h-14 bg-slate-50 border border-slate-200 rounded-xl text-center text-base sm:text-lg lg:text-xl font-bold font-mono text-slate-900 outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all select-all"
                   data-index="<%= i %>"
                   required
                   autocomplete="one-time-code">
          <% } %>
        </div>

        <!-- Hidden input for final submitted 6 digit code -->
        <input type="hidden" name="otp" id="finalOtpInput" value="">
      </div>

      <!-- Info Expiration -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-center">
        <p class="text-[11px] text-slate-500 flex items-center justify-center gap-1.5 font-sans">
          <i class="fa-regular fa-clock text-xs text-blue-600"></i>
          <span>Kode berlaku selama <strong class="text-slate-800 font-semibold">5 menit</strong></span>
        </p>
      </div>

      <!-- Submit Button -->
      <button type="submit" id="btnSubmitOtp" class="bg-blue-600 hover:bg-blue-500 text-white w-full py-3.5 rounded-xl text-xs font-semibold font-outfit shadow-btn transition-all flex items-center justify-center gap-1.5 sm:gap-2 mt-1 active:scale-95 cursor-pointer">
        <span>VERIFIKASI EMAIL</span> <i class="fas fa-arrow-right text-xs"></i>
      </button>
    </form>

    <!-- Resend OTP Section -->
    <div class="mt-6 pt-5 border-t border-slate-100 text-center">
      <p class="text-xs text-slate-500 mb-2 font-sans">
        Belum menerima kode OTP?
      </p>

      <form method="POST" action="/verify-otp/resend" id="resendOtpForm">
        <button type="submit" id="btnResendOtp" 
                class="inline-flex items-center gap-1.5 sm:gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-xl text-xs font-medium active:scale-95 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                <%= (typeof cooldownRemaining !== 'undefined' && cooldownRemaining > 0) ? 'disabled' : '' %>>
          <i class="fa-solid fa-rotate-right text-xs"></i>
          <span id="resendBtnText">Kirim Ulang OTP</span>
          <span id="resendCountdown" class="<%= (typeof cooldownRemaining !== 'undefined' && cooldownRemaining > 0) ? 'inline-block' : 'hidden' %> bg-slate-900 text-white px-1.5 py-0.5 rounded text-[10px] font-mono">
            <%= (typeof cooldownRemaining !== 'undefined' && cooldownRemaining > 0) ? String(cooldownRemaining).padStart(2, '0') + 's' : '00:60' %>
          </span>
        </button>
      </form>
    </div>

    <!-- Link Logout / Ganti Akun -->
    <p class="mt-6 text-center text-xs text-slate-500 pt-4 border-t border-slate-100 font-sans">
      Salah email atau akun? 
      <a href="/logout" class="text-rose-600 font-semibold hover:underline transition-colors">Keluar / Ganti Akun</a>
    </p>

  </div>
</div>

<script>
  // OTP 6 Digit Inputs Management
  const otpInputs = document.querySelectorAll('.otp-digit');
  const finalOtpInput = document.getElementById('finalOtpInput');
  const otpForm = document.getElementById('otpForm');

  if (otpInputs.length > 0) {
    otpInputs[0].focus();

    otpInputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/\D/g, '');
        e.target.value = val ? val.charAt(val.length - 1) : '';

        if (e.target.value && index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }
        updateFinalOtp();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          otpInputs[index - 1].focus();
        }
      });

      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/\D/g, '');
        if (pasteData) {
          for (let i = 0; i < Math.min(pasteData.length, otpInputs.length); i++) {
            otpInputs[i].value = pasteData[i];
          }
          const nextIndex = Math.min(pasteData.length, otpInputs.length - 1);
          otpInputs[nextIndex].focus();
          updateFinalOtp();
        }
      });
    });
  }

  function updateFinalOtp() {
    let combined = '';
    otpInputs.forEach(input => {
      combined += input.value;
    });
    finalOtpInput.value = combined;
  }

  otpForm.addEventListener('submit', (e) => {
    updateFinalOtp();
    if (finalOtpInput.value.length !== 6) {
      e.preventDefault();
      alert('Silakan masukkan 6 digit kode OTP secara lengkap.');
    }
  });

  // Cooldown Countdown Timer
  let cooldownSec = <%= typeof cooldownRemaining !== 'undefined' ? cooldownRemaining : 0 %>;
  const btnResend = document.getElementById('btnResendOtp');
  const countdownEl = document.getElementById('resendCountdown');

  function startCountdown() {
    if (cooldownSec <= 0) {
      if (btnResend) btnResend.disabled = false;
      if (countdownEl) countdownEl.classList.add('hidden');
      return;
    }

    if (btnResend) btnResend.disabled = true;
    if (countdownEl) {
      countdownEl.classList.remove('hidden');
      countdownEl.textContent = String(cooldownSec).padStart(2, '0') + 's';
    }

    const timer = setInterval(() => {
      cooldownSec--;
      if (cooldownSec <= 0) {
        clearInterval(timer);
        if (btnResend) btnResend.disabled = false;
        if (countdownEl) countdownEl.classList.add('hidden');
      } else {
        if (countdownEl) {
          countdownEl.textContent = String(cooldownSec).padStart(2, '0') + 's';
        }
      }
    }, 1000);
  }

  startCountdown();
</script>

<%- include('partials/footer') %>
