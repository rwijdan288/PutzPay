<%- include('partials/header', { title: 'Lupa Password' }) %>

<div class="min-h-screen sm:min-h-[75vh] flex flex-col items-center justify-center py-5 sm:py-6 px-4">
  
  <div class="w-full max-w-md bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-7 sm:p-9 shadow-sm sm:shadow-card relative">

    <!-- Header Logo & Title -->
    <div class="text-center mb-8">
      <% if (settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="Logo" class="w-14 h-14 rounded-lg sm:rounded-2xl object-cover mx-auto mb-4 border border-slate-200 shadow-xs p-1 bg-slate-50">
      <% } else { %>
        <div class="w-14 h-14 rounded-lg sm:rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mx-auto mb-4">
          <i class="fa-solid fa-key"></i>
        </div>
      <% } %>
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight font-outfit">Lupa Password</h2>
      <p class="text-xs text-slate-500 mt-1 font-sans">Masukkan username atau email terdaftar Anda untuk mereset kata sandi</p>
    </div>

    <!-- Alert Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg sm:rounded-2xl mb-6 text-xs font-medium flex items-center gap-2 sm:gap-3">
        <div class="w-6 h-6 rounded-lg bg-rose-100 flex items-center justify-center shrink-0 text-rose-600">
          <i class="fas fa-exclamation-circle text-xs"></i>
        </div>
        <p class="leading-snug"><%= error %></p>
      </div>
    <% } %>

    <!-- Alert Success -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg sm:rounded-2xl mb-6 text-xs font-medium flex items-center gap-2 sm:gap-3">
        <div class="w-6 h-6 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 text-emerald-600">
          <i class="fas fa-check-circle text-xs"></i>
        </div>
        <p class="leading-snug"><%= success %></p>
      </div>
    <% } %>

    <!-- Form Lupa Password -->
    <form method="POST" action="/forgot-password" class="flex flex-col gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5 px-1 font-sans">Email atau Username</label>
        <div class="relative flex items-center">
          <span class="absolute left-3.5 text-slate-400 text-xs"><i class="fa-regular fa-envelope"></i></span>
          <input name="login" type="text" placeholder="username atau email" 
                 class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-xs font-sans text-slate-900 outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all placeholder:text-slate-400" 
                 required
                 oninput="this.value = this.value.toLowerCase()">
        </div>
      </div>

      <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white w-full py-3.5 rounded-xl text-xs font-semibold font-outfit shadow-btn transition-all flex items-center justify-center gap-1.5 sm:gap-2 mt-2 active:scale-95 cursor-pointer">
        Kirim Instruksi Reset <i class="fas fa-paper-plane text-xs"></i>
      </button>
    </form>

    <!-- Link Kembali ke Login -->
    <p class="mt-8 text-center text-xs text-slate-500 border-t border-slate-100 pt-6 font-sans">
      Sudah ingat password Anda? 
      <a href="/login" class="text-blue-600 font-semibold hover:underline transition-colors">Kembali ke Login</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
