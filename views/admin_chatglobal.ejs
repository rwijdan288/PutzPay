<%- include('partials/header', { title: 'Admin Global Chat Moderasi' }) %>

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 md:py-8 space-y-6 w-full min-w-0 font-sans">

  <!-- Header Section -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl sm:rounded-3xl p-6 text-white shadow-sm sm:shadow-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative overflow-hidden">
    <div class="space-y-1.5 z-10">
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1 rounded-full bg-purple-500/20 text-purple-400 text-xs font-semibold uppercase tracking-wider border border-purple-500/30">
        <i class="fa-solid fa-shield-halved text-xs"></i>
        <span>Pusat Moderasi Komunitas</span>
      </div>
      <h1 class="text-base sm:text-lg lg:text-xl lg:text-2xl lg:text-3xl font-bold tracking-tight text-white font-outfit">Moderasi Chat Global Admin</h1>
      <p class="text-xs sm:text-sm text-slate-400">Pantau seluruh percakapan publik, hapus pesan pelanggaran, mute, atau ban pengguna nakal secara Realtime.</p>
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2 bg-slate-800/80 border border-slate-700/80 px-4 py-2 rounded-xl text-slate-200 self-start sm:self-center z-10">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-medium font-mono text-emerald-400">Moderation Active</span>
    </div>
  </div>

  <!-- Dashboard Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Global Messages Stream Panel (Left 8 cols) -->
    <div class="lg:col-span-8 bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl shadow-sm sm:shadow-card flex flex-col h-[700px] overflow-hidden">
      
      <!-- Top Stream Header & Search -->
      <div class="p-4 bg-white border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3">
        <div class="flex items-center gap-1.5 sm:gap-2 font-outfit font-bold text-sm text-slate-900">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
            <i class="fa-solid fa-comments"></i>
          </div>
          <span>Live Feed Pesan Global</span>
        </div>

        <div class="relative w-full sm:w-64">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
          <input id="adminGlobalSearch" type="text" placeholder="Cari pesan atau username..." 
                 class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 placeholder:text-slate-400 transition-all font-sans">
        </div>
      </div>

      <!-- Messages Stream -->
      <div id="adminGlobalMessagesContainer" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-3 bg-slate-50 custom-scroll">
        <div class="p-8 text-center text-xs text-slate-400">
          <i class="fa-solid fa-spinner animate-spin text-lg mb-2 text-blue-600"></i>
          <p>Memuat live feed chat global...</p>
        </div>
      </div>

    </div>

    <!-- Moderation & User Status Panel (Right 4 cols) -->
    <div class="lg:col-span-4 space-y-6">

      <!-- Moderated Users Card -->
      <div class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-5 shadow-sm sm:shadow-card space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="font-outfit font-bold text-sm text-slate-900 flex items-center gap-1.5 sm:gap-2">
            <div class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-xs">
              <i class="fa-solid fa-user-slash"></i>
            </div>
            <span>Daftar User Mute / Ban</span>
          </h2>
          <button onclick="loadModeratedUsers()" class="p-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-xs text-slate-600 transition-colors cursor-pointer" title="Refresh">
            <i class="fa-solid fa-rotate"></i>
          </button>
        </div>

        <!-- Moderated User List -->
        <div id="moderatedUsersList" class="space-y-2.5 max-h-[550px] overflow-y-auto custom-scroll pr-1">
          <div class="text-center p-4 text-xs text-slate-400">
            Memuat daftar sanksi user...
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- Mute / Ban Modal -->
<div id="moderateUserModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-slate-950/70 backdrop-blur-xs p-4">
  <div class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-4 font-sans">
    
    <div class="flex justify-between items-center border-b border-slate-100 pb-3">
      <div class="flex items-center gap-1.5 sm:gap-2">
        <div class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
          <i class="fa-solid fa-shield-halved text-xs"></i>
        </div>
        <h3 id="modModalTitle" class="font-outfit font-bold text-sm text-slate-900">Sanksi Moderasi User</h3>
      </div>
      <button onclick="closeModModal()" class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition-colors">
        <i class="fas fa-times text-sm"></i>
      </button>
    </div>

    <input type="hidden" id="modTargetUserId">
    <input type="hidden" id="modActionType">

    <div class="space-y-3 text-xs">
      <div>
        <label class="block mb-1 font-semibold text-slate-700">Target Pengguna:</label>
        <div id="modTargetUsername" class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold font-outfit text-sm text-slate-900">
          Username
        </div>
      </div>

      <div id="modDurationGroup">
        <label class="block mb-1 font-semibold text-slate-700">Durasi Mute (Menit):</label>
        <select id="modDurationSelect" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl p-2.5 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-slate-900 transition-all">
          <option value="5">5 Menit</option>
          <option value="60">1 Jam (60 Menit)</option>
          <option value="1440">24 Jam (1 Hari)</option>
          <option value="0">Selamanya (Permanen)</option>
        </select>
      </div>

      <div>
        <label class="block mb-1 font-semibold text-slate-700">Alasan Sanksi:</label>
        <textarea id="modReasonInput" rows="3" placeholder="Masukkan alasan tindakan ini..." 
                  class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl p-2.5 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 text-slate-900 transition-all"></textarea>
      </div>
    </div>

    <div class="flex gap-1.5 sm:gap-2.5 pt-2">
      <button onclick="closeModModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 rounded-xl font-semibold text-xs text-slate-700 transition-colors cursor-pointer">
        Batal
      </button>
      <button onclick="submitModerationAction()" class="flex-1 py-2.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl font-semibold text-xs transition-colors shadow-btn active:scale-95 cursor-pointer">
        Terapkan Sanksi
      </button>
    </div>

  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const currentUser = <%- JSON.stringify(user) %>;
  const socket = io();

  socket.emit('join_global_chat');

  const adminGlobalMessagesContainer = document.getElementById('adminGlobalMessagesContainer');
  const adminGlobalSearch = document.getElementById('adminGlobalSearch');
  const moderatedUsersList = document.getElementById('moderatedUsersList');

  let allGlobalMessages = [];
  let displayedMsgIds = new Set();
  let moderatedUsersData = [];

  socket.on('global:receive', (msg) => {
    allGlobalMessages.push(msg);
    renderStreamMessage(msg);
    forceScrollStream();
  });

  socket.on('global:delete', ({ messageId }) => {
    const el = document.getElementById(`admin-gmsg-${messageId}`);
    if (el) {
      const bubble = el.querySelector('.gmsg-bubble');
      if (bubble) {
        bubble.classList.add('bg-rose-50/50');
        bubble.innerHTML += `<div class="mt-1 text-[10px] font-mono text-rose-500 font-semibold">[Status: Dihapus oleh Admin]</div>`;
      }
    }
  });

  socket.on('global:user_status', () => {
    loadModeratedUsers();
  });

  async function loadGlobalStream() {
    try {
      const res = await fetch('/api/globalchat/messages', { credentials: 'include' });
      allGlobalMessages = await res.json();
      adminGlobalMessagesContainer.innerHTML = '';
      displayedMsgIds.clear();
      allGlobalMessages.forEach(renderStreamMessage);
      forceScrollStream();
    } catch (err) {
      console.error('Failed to load global stream:', err);
    }
  }

  function renderStreamMessage(msg) {
    if (displayedMsgIds.has(msg._id)) return;
    displayedMsgIds.add(msg._id);

    const query = (adminGlobalSearch.value || '').toLowerCase().trim();
    if (query && !msg.username.toLowerCase().includes(query) && !(msg.message || '').toLowerCase().includes(query)) {
      return;
    }

    const wrapper = document.createElement('div');
    wrapper.id = `admin-gmsg-${msg._id}`;
    wrapper.className = 'flex items-start gap-2 sm:gap-3 p-3.5 bg-white border border-slate-200/80 rounded-lg sm:rounded-2xl shadow-xs';

    const avatar = document.createElement('div');
    avatar.className = 'w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs font-outfit uppercase shrink-0 overflow-hidden shadow-xs';
    if (msg.profilePicture) {
      avatar.innerHTML = `<img src="${msg.profilePicture}" class="w-full h-full object-cover" alt="${msg.username}">`;
    } else {
      avatar.textContent = msg.username.charAt(0).toUpperCase();
    }

    const content = document.createElement('div');
    content.className = 'min-w-0 flex-1 gmsg-bubble';

    const header = document.createElement('div');
    header.className = 'flex items-center justify-between gap-1.5 sm:gap-2 mb-1';
    header.innerHTML = `
      <div class="flex items-center gap-1.5 text-xs font-bold font-outfit text-slate-900 truncate">
        <span>${msg.username}</span>
        ${msg.role === 'admin' ? '<span class="px-1.5 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-[9px]">ADMIN</span>' : ''}
      </div>
      <span class="text-[10px] text-slate-400">${new Date(msg.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}</span>
    `;
    content.appendChild(header);

    if (msg.image) {
      const img = document.createElement('img');
      img.src = msg.image;
      img.className = 'max-w-[180px] rounded-xl my-1 border border-slate-200';
      content.appendChild(img);
    }

    if (msg.message) {
      const txt = document.createElement('p');
      txt.className = 'text-xs text-slate-800 whitespace-pre-wrap leading-relaxed';
      txt.textContent = msg.message;
      content.appendChild(txt);
    }

    if (msg.isDeleted) {
      const delBadge = document.createElement('div');
      delBadge.className = 'mt-1 text-[10px] font-mono text-rose-500 font-semibold';
      delBadge.textContent = '[Status: Dihapus oleh Admin]';
      content.appendChild(delBadge);
    }

    // Action Controls
    const actions = document.createElement('div');
    actions.className = 'flex items-center gap-1.5 mt-2 pt-2 border-t border-slate-100';
    actions.innerHTML = `
      <button onclick="deleteGlobalMsg('${msg._id}')" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-lg text-[10px] font-semibold transition-colors cursor-pointer" title="Hapus Pesan">
        <i class="fa-solid fa-trash-can mr-1"></i> Hapus
      </button>
      <button onclick="openModModal('${msg.userId}', '${msg.username}', 'mute')" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg text-[10px] font-semibold transition-colors cursor-pointer" title="Mute User">
        <i class="fa-solid fa-volume-xmark mr-1"></i> Mute
      </button>
      <button onclick="openModModal('${msg.userId}', '${msg.username}', 'ban')" class="px-2 py-1 bg-slate-900 text-white hover:bg-slate-800 rounded-lg text-[10px] font-semibold transition-colors cursor-pointer" title="Ban User">
        <i class="fa-solid fa-ban mr-1"></i> Ban
      </button>
    `;
    content.appendChild(actions);

    wrapper.appendChild(avatar);
    wrapper.appendChild(content);

    adminGlobalMessagesContainer.appendChild(wrapper);
  }

  adminGlobalSearch.addEventListener('input', () => {
    adminGlobalMessagesContainer.innerHTML = '';
    displayedMsgIds.clear();
    allGlobalMessages.forEach(renderStreamMessage);
  });

  async function deleteGlobalMsg(messageId) {
    if (!confirm('Hapus pesan ini dari Chat Global?')) return;
    try {
      const res = await fetch('/api/globalchat/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messageId }),
        credentials: 'include'
      });
      const data = await res.json();
      if (!data.success) alert(data.error);
    } catch (err) {
      alert('Gagal menghapus pesan');
    }
  }

  async function loadModeratedUsers() {
    try {
      const res = await fetch('/api/admin/globalchat/users', { credentials: 'include' });
      moderatedUsersData = await res.json();

      const sanctioned = moderatedUsersData.filter(u => u.moderation && (u.moderation.isMuted || u.moderation.isBanned));

      if (sanctioned.length === 0) {
        moderatedUsersList.innerHTML = `
          <div class="text-center p-6 text-xs text-slate-400 bg-slate-50 border border-dashed border-slate-200 rounded-lg sm:rounded-2xl">
            <i class="fa-solid fa-circle-check text-xl text-emerald-500 mb-1"></i>
            <p>Tidak ada pengguna yang sedang disanksi.</p>
          </div>
        `;
        return;
      }

      moderatedUsersList.innerHTML = '';
      sanctioned.forEach(u => {
        const mod = u.moderation;
        const item = document.createElement('div');
        item.className = 'p-3 bg-slate-50 border border-slate-200 rounded-lg sm:rounded-2xl space-y-1.5 text-xs';

        let statusText = '';
        if (mod.isBanned) statusText = '<span class="px-2 py-0.5 bg-rose-50 text-rose-700 border border-rose-200 rounded-full font-semibold text-[10px]">🚫 BANNED</span>';
        else if (mod.isMuted) statusText = '<span class="px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full font-semibold text-[10px]">🔇 MUTED</span>';

        item.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-bold font-outfit text-slate-900 text-xs">${u.username}</span>
            ${statusText}
          </div>
          <p class="text-[11px] text-slate-500 truncate">Alasan: ${mod.reason || '-'}</p>
          <div class="flex gap-1.5 pt-1">
            ${mod.isMuted ? `<button onclick="unmuteUser('${u._id}')" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-[10px] font-semibold transition-all active:scale-95">Unmute</button>` : ''}
            ${mod.isBanned ? `<button onclick="unbanUser('${u._id}')" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-[10px] font-semibold transition-all active:scale-95">Unban</button>` : ''}
          </div>
        `;
        moderatedUsersList.appendChild(item);
      });
    } catch (err) {
      console.error('Failed to load moderated users:', err);
    }
  }

  function openModModal(userId, username, action) {
    document.getElementById('modTargetUserId').value = userId;
    document.getElementById('modActionType').value = action;
    document.getElementById('modTargetUsername').textContent = username;

    const modalTitle = document.getElementById('modModalTitle');
    const durGroup = document.getElementById('modDurationGroup');

    if (action === 'mute') {
      modalTitle.textContent = 'Mute Pengguna (Satu Arah)';
      durGroup.classList.remove('hidden');
    } else {
      modalTitle.textContent = 'Ban Pengguna dari Global Chat';
      durGroup.classList.add('hidden');
    }

    document.getElementById('moderateUserModal').classList.remove('hidden');
  }

  function closeModModal() {
    document.getElementById('moderateUserModal').classList.add('hidden');
  }

  async function submitModerationAction() {
    const targetUserId = document.getElementById('modTargetUserId').value;
    const action = document.getElementById('modActionType').value;
    const durationMinutes = document.getElementById('modDurationSelect').value;
    const reason = document.getElementById('modReasonInput').value;

    try {
      const res = await fetch('/api/globalchat/moderate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId, action, durationMinutes, reason }),
        credentials: 'include'
      });
      const data = await res.json();
      if (data.success) {
        closeModModal();
        loadModeratedUsers();
      } else {
        alert(data.error);
      }
    } catch (err) {
      alert('Gagal memproses moderasi');
    }
  }

  async function unmuteUser(targetUserId) {
    try {
      const res = await fetch('/api/globalchat/moderate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId, action: 'unmute' }),
        credentials: 'include'
      });
      const data = await res.json();
      if (data.success) loadModeratedUsers();
    } catch (err) {
      alert('Gagal unmute user');
    }
  }

  async function unbanUser(targetUserId) {
    try {
      const res = await fetch('/api/globalchat/moderate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetUserId, action: 'unban' }),
        credentials: 'include'
      });
      const data = await res.json();
      if (data.success) loadModeratedUsers();
    } catch (err) {
      alert('Gagal unban user');
    }
  }

  function forceScrollStream() {
    adminGlobalMessagesContainer.scrollTop = adminGlobalMessagesContainer.scrollHeight;
  }

  loadGlobalStream();
  loadModeratedUsers();
</script>

<%- include('partials/footer') %>
