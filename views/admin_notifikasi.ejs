<%- include('partials/header', { title: 'Notifikasi Massal - Admin' }) %>

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 md:py-8 space-y-6 sm:space-y-8 w-full min-w-0 font-sans">

  <!-- Header Section -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl sm:rounded-3xl p-6 sm:p-8 text-white shadow-sm sm:shadow-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative overflow-hidden">
    <div class="space-y-1.5 z-10">
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider border border-amber-500/30">
        <i class="fa-solid fa-bullhorn text-xs"></i>
        <span>Notification Broadcast Center</span>
      </div>
      <h1 class="text-base sm:text-lg lg:text-xl lg:text-2xl lg:text-3xl font-bold tracking-tight text-white font-outfit">Kirim Notifikasi & Pengumuman</h1>
      <p class="text-xs sm:text-sm text-slate-400 max-w-2xl">Kirim pesan pemberitahuan resmi secara realtime ke semua pengguna atau pengguna tertentu melalui Push Notification, Email & In-App Notification.</p>
    </div>

    <div class="z-10">
      <button type="button" onclick="openSendNotifModal()" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs transition-all flex items-center gap-1.5 sm:gap-2 shadow-btn active:scale-95 cursor-pointer">
        <i class="fa-solid fa-paper-plane text-xs"></i>
        <span>Kirim Pesan Baru</span>
      </button>
    </div>
  </div>

  <!-- Send Notification Form Modal -->
  <div id="sendNotifModal" class="fixed inset-0 z-[150] hidden flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
    <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-xs transition-opacity" onclick="closeSendNotifModal()"></div>
    <div class="relative bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden z-10 p-6 sm:p-8 space-y-5 my-8" id="sendNotifContent">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
            <i class="fa-solid fa-bell"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 font-outfit">Kirim Notifikasi Baru</h3>
            <p class="text-xs text-slate-500">Siarkan pengumuman atau kirim pesan langsung</p>
          </div>
        </div>
        <button onclick="closeSendNotifModal()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100 text-slate-400 hover:text-slate-700 transition-colors">
          <i class="fas fa-times text-sm"></i>
        </button>
      </div>

      <form method="POST" action="/admin/notifications/send" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Target Penerima</label>
          <div class="grid grid-cols-2 gap-2 sm:gap-3 text-xs">
            <label class="flex items-center gap-1.5 sm:gap-2.5 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100/70 transition-colors">
              <input type="radio" name="recipientType" value="all" checked onchange="toggleTargetUser(false)" class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600 border-slate-300 focus:ring-blue-500">
              <span class="font-medium text-slate-800">Semua Pengguna</span>
            </label>
            <label class="flex items-center gap-1.5 sm:gap-2.5 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100/70 transition-colors">
              <input type="radio" name="recipientType" value="user" onchange="toggleTargetUser(true)" class="w-3 h-3 sm:w-4 sm:h-4 text-blue-600 border-slate-300 focus:ring-blue-500">
              <span class="font-medium text-slate-800">Pengguna Tertentu</span>
            </label>
          </div>
        </div>

        <div id="targetUserContainer" class="hidden">
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Username Target <span class="text-rose-500">*</span></label>
          <input name="targetUsername" id="targetUsernameInput" type="text" placeholder="Contoh: user123" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-sans">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Judul Notifikasi <span class="text-rose-500">*</span></label>
          <input name="title" type="text" placeholder="Contoh: Pemeliharaan Server Selesai" required class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-sans">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Isi Pesan Notifikasi <span class="text-rose-500">*</span></label>
          <textarea name="message" rows="3" placeholder="Tuliskan isi pesan detail yang akan diterima oleh pengguna..." required class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl p-3.5 text-xs text-slate-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-sans"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Tipe Tampilan</label>
            <select name="type" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all">
              <option value="info">Info (Biru)</option>
              <option value="success">Sukses (Hijau)</option>
              <option value="warning">Peringatan (Kuning)</option>
              <option value="danger">Penting (Merah)</option>
              <option value="system">Sistem (Gelap)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Kanal Pengiriman</label>
            <select name="channel" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all">
              <option value="both">In-App + Web Push + Email</option>
              <option value="web_push">Web Push + In-App</option>
              <option value="email">Email + In-App</option>
              <option value="in_app">Hanya In-App Center</option>
            </select>
          </div>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white py-3 rounded-xl text-xs font-semibold font-outfit shadow-btn active:scale-95 transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer mt-2">
          <i class="fa-solid fa-paper-plane text-xs"></i>
          <span>Kirim Notifikasi Sekarang</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Notification History Table -->
  <div class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl shadow-sm sm:shadow-card overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
      <div class="flex items-center gap-1.5 sm:gap-2 font-bold font-outfit text-sm text-slate-900">
        <i class="fa-solid fa-clock-rotate-left text-slate-400"></i>
        <span>Riwayat Notifikasi Terkirim</span>
      </div>
      <span class="text-xs font-mono font-medium text-slate-500 bg-white border border-slate-200 px-3 py-1 rounded-full">Total <%= notifications.length %> Catatan</span>
    </div>

    <% if (notifications.length === 0) { %>
      <div class="p-12 text-center text-xs text-slate-400">
        <i class="fa-regular fa-bell-slash text-3xl mb-3 block text-slate-300"></i>
        Belum ada riwayat pengiriman notifikasi
      </div>
    <% } else { %>
      <div class="overflow-x-auto custom-scroll max-h-[600px]">
        <table class="w-full text-xs text-left whitespace-nowrap">
          <thead class="bg-slate-50 text-xs text-slate-600 font-semibold border-b border-slate-200 uppercase tracking-wider sticky top-0 z-10">
            <tr>
              <th class="px-5 py-3.5">Judul & Pesan</th>
              <th class="px-5 py-3.5">Target Penerima</th>
              <th class="px-5 py-3.5">Tipe</th>
              <th class="px-5 py-3.5">Kanal</th>
              <th class="px-5 py-3.5">Pengirim</th>
              <th class="px-5 py-3.5">Waktu</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700 font-mono">
            <% notifications.forEach(n => { %>
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="px-5 py-3.5 max-w-sm">
                  <div class="font-outfit font-bold text-xs text-slate-900 truncate"><%= n.title %></div>
                  <div class="text-[11px] text-slate-500 truncate mt-0.5"><%= n.message %></div>
                </td>
                <td class="px-5 py-3.5">
                  <% if (n.target === 'all') { %>
                    <span class="px-2.5 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-lg text-[10px] font-semibold">
                      <i class="fa-solid fa-users text-[9px] mr-1"></i> Semua User
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-[10px] font-semibold">
                      <i class="fa-solid fa-user text-[9px] mr-1"></i> @<%= n.targetUsername || 'User' %>
                    </span>
                  <% } %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase <%= n.type === 'danger' ? 'bg-rose-50 text-rose-700 border border-rose-200' : (n.type === 'warning' ? 'bg-amber-50 text-amber-700 border border-amber-200' : (n.type === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-blue-50 text-blue-700 border border-blue-200')) %>">
                    <%= n.type || 'info' %>
                  </span>
                </td>
                <td class="px-5 py-3.5 uppercase text-[11px] text-slate-600">
                  <%= n.channel || 'both' %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="font-semibold text-slate-900">@<%= n.sender || 'Admin' %></span>
                </td>
                <td class="px-5 py-3.5 text-slate-500 text-[11px]">
                  <%= new Date(n.createdAt).toLocaleString('id-ID') %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<script>
  function openSendNotifModal() {
    document.getElementById('sendNotifModal').classList.remove('hidden');
  }

  function closeSendNotifModal() {
    document.getElementById('sendNotifModal').classList.add('hidden');
  }

  function toggleTargetUser(show) {
    const el = document.getElementById('targetUserContainer');
    const input = document.getElementById('targetUsernameInput');
    if (show) {
      el.classList.remove('hidden');
      input.setAttribute('required', 'true');
    } else {
      el.classList.add('hidden');
      input.removeAttribute('required');
      input.value = '';
    }
  }
</script>

<%- include('partials/footer') %>
