      <!-- Code Box -->
      <div class="relative bg-slate-950 border border-slate-800 rounded-lg sm:rounded-2xl p-4 overflow-hidden">
        <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-800 text-slate-400 font-mono text-[11px]">
          <span id="modalLangLabel" class="uppercase font-semibold text-blue-400">Axios JavaScript</span>
          <button onclick="copyModalRequestCode()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="far fa-copy text-xs"></i>
            <span>Salin Code</span>
          </button>
        </div>
        <div class="overflow-x-auto custom-scroll max-h-[350px]">
          <pre id="modalReqCode" class="text-xs font-mono text-emerald-400 leading-relaxed whitespace-pre font-medium"></pre>
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="bg-slate-50 border-t border-slate-200 p-3.5 sm:p-4 flex items-center justify-between text-xs font-mono text-slate-500 shrink-0">
      <span>PutzPay API v2.0 Official</span>
      <button onclick="closeRequestModal()" class="px-4 py-1.5 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 cursor-pointer transition-all">Tutup</button>
    </div>

  </div>
</div>

<!-- MODAL RESPONSE (LIHAT RESPONSE) -->
<div id="response-code-modal" class="fixed inset-0 z-[99990] flex items-center justify-center p-3 sm:p-5 backdrop-blur-xs bg-slate-950/60 opacity-0 pointer-events-none transition-all duration-300">
  <div class="relative bg-white border border-slate-200 rounded-2xl sm:rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
    
    <!-- Modal Header -->
    <div class="bg-slate-50 border-b border-slate-200 p-4 sm:p-5 flex items-center justify-between gap-2 sm:gap-3 shrink-0">
      <div class="flex items-center gap-1.5 sm:gap-2.5 min-w-0">
        <div class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
          <i class="fa-solid fa-brackets-curly"></i>
        </div>
        <h3 id="modalResTitle" class="text-xs sm:text-sm lg:text-base font-bold text-slate-900 font-outfit truncate">Example JSON Response</h3>
      </div>
      <button onclick="closeResponseModal()" class="w-8 h-8 rounded-xl bg-white border border-slate-200 text-slate-500 hover:text-slate-900 hover:bg-slate-100 font-bold text-sm flex items-center justify-center cursor-pointer transition-all shrink-0">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-4 sm:p-6 space-y-3 overflow-y-auto custom-scroll">
      <div class="relative bg-slate-950 border border-slate-800 rounded-lg sm:rounded-2xl p-4">
        <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-800 text-slate-400 font-mono text-[11px]">
          <span class="uppercase font-semibold text-emerald-400">Status 200 OK (application/json)</span>
          <button onclick="copyModalResponseCode()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="far fa-copy text-xs"></i>
            <span>Salin JSON</span>
          </button>
        </div>
        <div class="overflow-x-auto custom-scroll max-h-[350px]">
          <pre id="modalResCode" class="text-xs font-mono text-emerald-400 leading-relaxed whitespace-pre font-medium"></pre>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="bg-slate-50 border-t border-slate-200 p-3.5 sm:p-4 flex items-center justify-between text-xs font-mono text-slate-500 shrink-0">
      <span>PutzPay API Response Standard</span>
      <button onclick="closeResponseModal()" class="px-4 py-1.5 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 cursor-pointer transition-all">Tutup</button>
    </div>

  </div>
</div>

<script>
  // Context state
  const appApiKey = "<%= userApiKey || 'YOUR_API_KEY' %>";
  const baseUrl = window.location.origin;

  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('globalBaseUrlText');
    if (el) el.textContent = baseUrl;
  });

  // Example JSON Response Objects
  const balanceResponseExample = {
    "success": true,
    "balance": 250000,
    "currency": "IDR"
  };

  const createQrisResponseExample = {
    "success": true,
    "status": "pending",
    "invoice_id": "ord7a9f12b",
    "amount": 50000,
    "fee": 250,
    "total_amount": 50250,
    "qr_string": "00020101021226670014ID.LINKAJA.WWW011893600014000001089202150000000000000010303UMI51440014ID.CO.QRIS.WWW0215ID10200210000010303UMI5204581253033605802ID5909PUTZPAY6007JAKARTA61051234562070703A016304ABCD",
    "qr_image_url": `${baseUrl}/qr/ord7a9f12b.png`,
    "checkout_url": `${baseUrl}/invoice/ord7a9f12b`,
    "expired_at": "2026-09-03T10:00:00.000Z"
  };

  const invoiceStatusResponseExample = {
    "success": true,
    "invoice_id": "ord7a9f12b",
    "status": "paid",
    "amount": 50000,
    "settlement_amount": 50000,
    "paid_at": "2026-09-03T09:15:22.000Z",
    "customer": {
      "name": "Budi Santoso",
      "email": "customer@example.com"
    }
  };

  const cancelInvoiceResponseExample = {
    "success": true,
    "invoice_id": "ord7a9f12b",
    "status": "cancelled",
    "message": "Invoice berhasil dibatalkan"
  };

  const historyResponseExample = {
    "success": true,
    "count": 2,
    "data": [
      {
        "id": "ord7a9f12b",
        "type": "deposit",
        "nominal": 50000,
        "status": "paid",
        "created_at": "2026-09-03T09:10:00.000Z"
      },
      {
        "id": "wd9f21ab",
        "type": "withdraw",
        "nominal": 100000,
        "status": "success",
        "created_at": "2026-09-02T15:40:00.000Z"
      }
    ]
  };

  const withdrawResponseExample = {
    "success": true,
    "message": "Permohonan penarikan berhasil diajukan dan sedang diproses oleh admin",
    "withdraw_id": "wd881fbc",
    "amount": 50000,
    "fee": 500,
    "total_deducted": 50500,
    "status": "pending"
  };

  const instantWithdrawResponseExample = {
    "success": true,
    "status": "success",
    "message": "Pencairan instan saldo berhasil ditransfer",
    "target_ewallet": "dana",
    "target_number": "081234567890",
    "nominal": 50000,
    "fee": 500,
    "trx_id": "WD-INS-981249"
  };

  // Modal Code State
  let currentModalReq = {
    method: 'POST',
    endpoint: '/api/balance',
    title: 'Cek Saldo',
    body: null,
    lang: 'axios'
  };

  function openRequestModal(method, endpoint, title, sampleBody = null) {
    currentModalReq.method = method;
    currentModalReq.endpoint = endpoint;
    currentModalReq.title = title;
    currentModalReq.body = sampleBody;

    document.getElementById('modalReqMethodBadge').textContent = method;
    document.getElementById('modalReqTitle').textContent = `${title} (${endpoint})`;

    switchModalLanguage(currentModalReq.lang || 'axios');

    const modal = document.getElementById('request-code-modal');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
  }

  function closeRequestModal() {
    const modal = document.getElementById('request-code-modal');
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
  }

  function switchModalLanguage(lang) {
    currentModalReq.lang = lang;

    // Update Tab Styles
    document.querySelectorAll('.modal-lang-tab').forEach(btn => {
      btn.className = 'modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200';
    });
    const activeTab = document.getElementById('langTab-' + lang);
    if (activeTab) {
      activeTab.className = 'modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-blue-600 text-white shadow-xs';
    }

    const langLabelEl = document.getElementById('modalLangLabel');
    const codeEl = document.getElementById('modalReqCode');

    const fullUrl = `${baseUrl}${currentModalReq.endpoint}`;
    const key = appApiKey;
    const hasBody = currentModalReq.body && Object.keys(currentModalReq.body).length > 0;
    const jsonBody = hasBody ? JSON.stringify(currentModalReq.body, null, 2) : '';

    let code = '';

    if (lang === 'axios') {
      langLabelEl.textContent = 'Axios JavaScript';
      if (currentModalReq.method === 'POST') {
        code = `const axios = require('axios');

async function callPutzPay() {
  try {
    const response = await axios.post('${fullUrl}', ${hasBody ? JSON.stringify(currentModalReq.body, null, 4) : '{}'}, {
      headers: {
        'x-apikey': '${key}',
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }
    });

    console.log(response.data);
  } catch (error) {
    console.error(error.response ? error.response.data : error.message);
  }
}

callPutzPay();`;
      } else {
        code = `const axios = require('axios');

async function callPutzPay() {
  try {
    const response = await axios.get('${fullUrl}?apikey=${key}', {
      headers: { 'Accept': 'application/json' }
    });
    console.log(response.data);
  } catch (error) {
    console.error(error.response ? error.response.data : error.message);
  }
}

callPutzPay();`;
      }
    } else if (lang === 'fetch') {
      langLabelEl.textContent = 'JavaScript Fetch API';
      code = `async function callPutzPay() {
  try {
    const res = await fetch('${fullUrl}', {
      method: '${currentModalReq.method}',
      headers: {
        'x-apikey': '${key}',
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }${hasBody ? `,\n      body: JSON.stringify(${JSON.stringify(currentModalReq.body, null, 8)})` : ''}
    });

    const data = await res.json();
    console.log(data);
  } catch (err) {
    console.error(err);
  }
}

callPutzPay();`;
    } else if (lang === 'curl') {
      langLabelEl.textContent = 'cURL Command Line';
      if (currentModalReq.method === 'POST') {
        code = `curl -X POST "${fullUrl}" \\
  -H "x-apikey: ${key}" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json"${hasBody ? ` \\\n  -d '${JSON.stringify(currentModalReq.body)}'` : ''}`;
      } else {
        code = `curl -X GET "${fullUrl}?apikey=${key}" \\
  -H "Accept: application/json"`;
      }
    } else if (lang === 'php') {
      langLabelEl.textContent = 'PHP cURL';
      code = `<?php
$curl = curl_init();

curl_setopt_array($curl, array(
  CURLOPT_URL => '${fullUrl}',
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_ENCODING => '',
  CURLOPT_MAXREDIRS => 10,
  CURLOPT_TIMEOUT => 0,
  CURLOPT_FOLLOWLOCATION => true,
  CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
  CURLOPT_CUSTOMREQUEST => '${currentModalReq.method}',
  CURLOPT_HTTPHEADER => array(
    'x-apikey: ${key}',
    'Content-Type: application/json',
    'Accept: application/json'
  ),${hasBody ? `\n  CURLOPT_POSTFIELDS => '${JSON.stringify(currentModalReq.body)}',` : ''}
));

$response = curl_exec($curl);
curl_close($curl);
echo $response;
?>`;
    } else if (lang === 'python') {
      langLabelEl.textContent = 'Python Requests';
      code = `import requests

url = "${fullUrl}"
headers = {
    "x-apikey": "${key}",
    "Content-Type": "application/json",
    "Accept": "application/json"
}
${hasBody ? `payload = ${JSON.stringify(currentModalReq.body, null, 4)}

response = requests.request("${currentModalReq.method}", url, headers=headers, json=payload)` : `response = requests.request("${currentModalReq.method}", url, headers=headers)`}

print(response.json())`;
    } else if (lang === 'nodejs') {
      langLabelEl.textContent = 'Node.js Native HTTPS';
      code = `const https = require('https');

const data = JSON.stringify(${hasBody ? JSON.stringify(currentModalReq.body) : '{}'});

const options = {
  hostname: '${window.location.hostname}',
  port: 443,
  path: '${currentModalReq.endpoint}',
  method: '${currentModalReq.method}',
  headers: {
    'x-apikey': '${key}',
    'Content-Type': 'application/json',
    'Content-Length': data.length
  }
};

const req = https.request(options, res => {
  let body = '';
  res.on('data', chunk => body += chunk);
  res.on('end', () => console.log(JSON.parse(body)));
});

req.on('error', error => console.error(error));
${hasBody ? 'req.write(data);\n' : ''}req.end();`;
    }

    codeEl.textContent = code;
  }

  function copyModalRequestCode() {
    const code = document.getElementById('modalReqCode').textContent;
    copyToClipboard(code, 'Code snippet berhasil disalin');
  }

  // Response Modal Handlers
  function openResponseModal(title, responseObj) {
    document.getElementById('modalResTitle').textContent = `Response JSON: ${title}`;
    document.getElementById('modalResCode').textContent = JSON.stringify(responseObj, null, 2);

    const modal = document.getElementById('response-code-modal');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
  }

  function closeResponseModal() {
    const modal = document.getElementById('response-code-modal');
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
  }

  function copyModalResponseCode() {
    const code = document.getElementById('modalResCode').textContent;
    copyToClipboard(code, 'JSON Response berhasil disalin');
  }

  // Interactive Tester
  function onTesterEndpointChange() {
    const ep = document.getElementById('testerEndpointSelect').value;
    const bodyInput = document.getElementById('testerBodyInput');

    if (ep === '/api/balance' || ep === '/api/history') {
      bodyInput.value = '{}';
    } else if (ep === '/api/create/qris') {
      bodyInput.value = JSON.stringify({ amount: 25000 }, null, 2);
    } else if (ep === '/api/invoice/status' || ep === '/api/invoice/cancel') {
      bodyInput.value = JSON.stringify({ invoice_id: 'ord7a9f12b' }, null, 2);
    } else if (ep === '/api/withdraw') {
      bodyInput.value = JSON.stringify({ amount: 50000, method: 'Dana', account_number: '081234567890', account_name: 'Budi' }, null, 2);
    } else if (ep === '/api/withdraw/instan') {
      bodyInput.value = JSON.stringify({ ewallet: 'dana', nomor: '081234567890', nominal: 50000 }, null, 2);
    }
  }

  async function sendApiTest() {
    const endpoint = document.getElementById('testerEndpointSelect').value;
    const apiKey = document.getElementById('testerApiKeyInput').value.trim();
    const rawBody = document.getElementById('testerBodyInput').value.trim();
    const submitBtn = document.getElementById('testerSubmitBtn');
    const output = document.getElementById('testerResponseOutput');
    const statusBadge = document.getElementById('testerStatusCode');

    let parsedBody = {};
    if (rawBody) {
      try {
        parsedBody = JSON.parse(rawBody);
      } catch (e) {
        showToast('Format JSON pada Request Body tidak valid');
        return;
      }
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-xs"></i><span>Mengirim...</span>`;
    output.textContent = '// Menghubungi server PutzPay...';
    statusBadge.classList.add('hidden');

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'x-apikey': apiKey,
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(parsedBody)
      });

      statusBadge.textContent = `${res.status} ${res.statusText || ''}`;
      statusBadge.className = `px-2 py-0.5 rounded-full text-[10px] font-mono font-bold border ${res.ok ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200'}`;
      statusBadge.classList.remove('hidden');

      const data = await res.json();
      output.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      output.textContent = JSON.stringify({ error: err.message }, null, 2);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane text-xs"></i><span>Kirim Request Uji Coba</span>`;
    }
  }

  function copyTesterResponse() {
    const text = document.getElementById('testerResponseOutput').textContent;
    copyToClipboard(text, 'Response berhasil disalin');
  }

  // Helper functions
  function copyToClipboard(text, toastMsg = 'Code berhasil disalin') {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(() => {
        showToast(toastMsg);
      }).catch(() => {
        fallbackCopy(text, toastMsg);
      });
    } else {
      fallbackCopy(text, toastMsg);
    }
  }

  function fallbackCopy(text, toastMsg) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand('copy');
      showToast(toastMsg);
    } catch (e) {
      console.error('Failed to copy', e);
    }
    document.body.removeChild(textarea);
  }

  function showToast(message) {
    const toast = document.getElementById('toast-container');
    const msgEl = document.getElementById('toast-message');
    if (!toast || !msgEl) return;
    msgEl.textContent = message;
    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
    }, 2500);
  }

  // Close modals on ESC key & Outside Click
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeRequestModal();
      closeResponseModal();
    }
  });

  document.getElementById('request-code-modal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('request-code-modal')) {
      closeRequestModal();
    }
  });

  document.getElementById('response-code-modal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('response-code-modal')) {
      closeResponseModal();
    }
  });
</script>

