          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider font-mono mb-1.5">Pilih Endpoint</label>
          <select id="testerEndpointSelect" onchange="onTesterEndpointChange()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-mono font-semibold text-slate-900 outline-none focus:border-blue-500 focus:bg-white transition-all">
            <option value="/api/balance">POST /api/balance (Cek Saldo)</option>
            <option value="/api/create/qris">POST /api/create/qris (Buat QRIS)</option>
            <option value="/api/invoice/status">POST /api/invoice/status (Cek Status)</option>
            <option value="/api/invoice/cancel">POST /api/invoice/cancel (Batalkan)</option>
            <option value="/api/history">POST /api/history (Riwayat)</option>
            <option value="/api/withdraw">POST /api/withdraw (Tarik Saldo)</option>
            <option value="/api/withdraw/instan">POST /api/withdraw/instan (Tarik Instan)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider font-mono mb-1.5">API Key</label>
          <input id="testerApiKeyInput" type="text" value="<%= userApiKey || '' %>" placeholder="Masukkan API Key Anda..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-mono font-semibold text-slate-900 outline-none focus:border-blue-500 focus:bg-white transition-all">
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider font-mono">Request Body (JSON)</label>
            <span class="text-[10px] font-mono text-slate-400">application/json</span>
          </div>
          <textarea id="testerBodyInput" rows="5" class="w-full bg-slate-950 text-slate-100 font-mono text-xs rounded-xl p-3 border border-slate-800 outline-none focus:border-blue-500 transition-all">{
  "amount": 10000
}</textarea>
        </div>

        <button id="testerSubmitBtn" onclick="sendApiTest()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs py-3 rounded-xl shadow-btn active:scale-95 transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer">
          <i class="fa-solid fa-paper-plane text-xs"></i>
          <span>Kirim Request Uji Coba</span>
        </button>
      </div>

      <!-- Output Tester Box -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 uppercase tracking-wider font-mono">Hasil Response JSON</span>
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span id="testerStatusCode" class="hidden px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-100 text-slate-600 border border-slate-200"></span>
            <button onclick="copyTesterResponse()" class="text-xs font-semibold text-slate-600 hover:text-blue-600 flex items-center gap-1 transition-colors cursor-pointer">
              <i class="far fa-copy text-xs"></i> Salin
            </button>
          </div>
        </div>

        <div class="relative bg-slate-950 rounded-lg sm:rounded-2xl p-4 border border-slate-800 min-h-[220px] max-h-[340px] overflow-y-auto custom-scroll">
          <pre id="testerResponseOutput" class="text-xs font-mono text-emerald-400 whitespace-pre-wrap leading-relaxed">// Klik "Kirim Request Uji Coba" untuk melihat hasil response</pre>
        </div>
      </div>

    </div>
  </div>

</div>

<!-- MODAL REQUEST (LIHAT CODE) -->
<div id="request-code-modal" class="fixed inset-0 z-[99990] flex items-center justify-center p-3 sm:p-5 backdrop-blur-xs bg-slate-950/60 opacity-0 pointer-events-none transition-all duration-300">
  <div class="relative bg-white border border-slate-200 rounded-2xl sm:rounded-3xl w-full max-w-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="bg-slate-50 border-b border-slate-200 p-4 sm:p-5 flex items-center justify-between gap-2 sm:gap-3 shrink-0">
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <span id="modalReqMethodBadge" class="px-2.5 py-1 rounded-xl bg-blue-50 text-blue-700 font-mono font-bold text-xs border border-blue-200">POST</span>
