        <button onclick="switchModalLanguage('axios')" id="langTab-axios" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-blue-600 text-white shadow-xs">Axios</button>
        <button onclick="switchModalLanguage('fetch')" id="langTab-fetch" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">Fetch</button>
        <button onclick="switchModalLanguage('curl')" id="langTab-curl" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">cURL</button>
        <button onclick="switchModalLanguage('php')" id="langTab-php" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">PHP</button>
        <button onclick="switchModalLanguage('python')" id="langTab-python" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">Python</button>
        <button onclick="switchModalLanguage('nodejs')" id="langTab-nodejs" class="modal-lang-tab px-3 py-1.5 rounded-xl text-xs font-semibold font-mono cursor-pointer transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">NodeJS</button>
