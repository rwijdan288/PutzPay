<%- include('partials/header', { title: 'Dokumentasi API & Integrasi Developer' }) %>

<!-- TOAST NOTIFICATION -->
<div id="toast-container" class="fixed bottom-6 right-6 z-[99999] transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none">
  <div class="bg-slate-900 text-white border border-slate-800 px-4 py-3 rounded-lg sm:rounded-2xl font-sans text-xs font-semibold shadow-xl flex items-center gap-1.5 sm:gap-2.5">
    <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
      <i class="fa-solid fa-circle-check text-xs"></i>
    </div>
    <span id="toast-message">Code berhasil disalin</span>
  </div>
</div>

<div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-6 md:py-8 space-y-8 w-full min-w-0">
  
  <!-- HERO BANNER SECTION (MODERN FINTECH SLATE THEME) -->
  <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-slate-900 via-slate-850 to-blue-950 text-white p-6 sm:p-9 shadow-sm sm:shadow-card border border-slate-800">
    <!-- Decorative background glow -->
    <div class="absolute -right-12 -top-12 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 space-y-6">
      
      <!-- Top Badges & Title -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold font-mono border border-blue-400/30">
              <i class="fa-solid fa-code text-[11px]"></i> REST API v2.0
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold font-mono border border-emerald-400/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Production Ready
            </span>
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 text-slate-300 text-xs font-medium border border-white/10">
              Auto-Settlement Engine
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white font-outfit">
            Dokumentasi API PutzPay
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 font-sans max-w-2xl leading-relaxed">
            Integrasikan layanan pembayaran QRIS otomatis, cek saldo, invoice instant, pembatalan transaksi, riwayat mutasi, dan pencairan saldo otomatis 24/7 langsung ke platform atau bot aplikasi Anda.
          </p>
        </div>

        <!-- API KEY CARD -->
        <% if (userApiKey) { %>
          <div class="bg-slate-900/90 backdrop-blur-sm border border-slate-700/80 rounded-lg sm:rounded-2xl p-4 shrink-0 shadow-lg w-full lg:w-auto">
            <div class="flex items-center justify-between gap-1.5 sm:gap-2 mb-2">
              <span class="text-xs font-bold text-slate-300 font-sans flex items-center gap-1.5">
                <i class="fa-solid fa-key text-amber-400"></i> API Key Anda
              </span>
              <span class="bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold">AKTIF</span>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2">
              <code class="text-xs font-mono text-cyan-300 bg-slate-950/80 px-3 py-2 rounded-xl border border-slate-800 break-all select-all" id="userApiKeyText"><%= userApiKey %></code>
              <button onclick="copyToClipboard('<%= userApiKey %>', 'API Key berhasil disalin')" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer shrink-0 shadow-xs active:scale-95" title="Salin API Key">
                <i class="far fa-copy text-xs"></i>
                <span>Salin</span>
              </button>
            </div>
          </div>
        <% } else { %>
          <div class="bg-slate-900/90 backdrop-blur-sm border border-slate-700/80 rounded-lg sm:rounded-2xl p-4 shrink-0 shadow-lg w-full lg:w-auto text-left">
            <span class="text-xs font-bold text-slate-300 block mb-1">Status Kredensial API</span>
            <p class="text-xs text-slate-400 mb-3">Login ke akun Anda untuk melihat atau menyalin API Key pribadi.</p>
            <a href="/login" class="inline-flex items-center gap-1.5 sm:gap-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-xl shadow-xs transition-all active:scale-95">
              <span>Masuk ke Akun</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
        <% } %>
      </div>

      <!-- SYSTEM STATUS BADGES & QUICK JUMP -->
      <div class="pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 sm:gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <span class="text-slate-400 font-sans font-medium mr-1">Status Server:</span>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-800/80 border border-slate-700 rounded-lg text-[11px] font-mono text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>API Online</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-800/80 border border-slate-700 rounded-lg text-[11px] font-mono text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Database</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-800/80 border border-slate-700 rounded-lg text-[11px] font-mono text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>QRIS Engine</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-800/80 border border-slate-700 rounded-lg text-[11px] font-mono text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Socket.IO</span>
          </div>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 text-slate-300 font-mono text-[11px]">
          <span class="text-slate-400">Base URL:</span>
          <code class="text-blue-300 bg-slate-950/60 px-2 py-0.5 rounded border border-slate-800 font-semibold" id="globalBaseUrlText">https://putzpay.biz.id</code>
        </div>
      </div>

    </div>
  </div>

  <!-- QUICK NAVIGATION CHIPS -->
  <div class="bg-white border border-slate-200/80 rounded-lg sm:rounded-2xl p-3 shadow-xs flex items-center gap-1.5 sm:gap-2 overflow-x-auto custom-scroll">
    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono px-2 shrink-0">Lompat Ke:</span>
    <a href="#auth-section" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all shrink-0">Autentikasi</a>
    <a href="#endpoint-balance" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/balance</a>
    <a href="#endpoint-create-qris" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/create/qris</a>
    <a href="#endpoint-invoice-status" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/invoice/status</a>
    <a href="#endpoint-invoice-cancel" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/invoice/cancel</a>
    <a href="#endpoint-history" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/history</a>
    <a href="#endpoint-withdraw" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-all shrink-0">/api/withdraw</a>
    <a href="#endpoint-withdraw-instan" class="px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs font-semibold transition-all shrink-0">/api/withdraw/instan</a>
    <a href="#section-status-codes" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all shrink-0">Status Codes</a>
    <a href="#section-api-tester" class="px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-semibold transition-all shrink-0">API Tester</a>
  </div>

  <!-- SECTION 1: AUTENTIKASI & FORMAT PARAMETER -->
  <div id="auth-section" class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm sm:shadow-card w-full min-w-0 space-y-5">
    <div class="flex items-center gap-2 sm:gap-3">
      <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center font-bold text-sm font-mono shrink-0">1</div>
      <div>
        <h2 class="text-base sm:text-lg lg:text-xl font-bold text-slate-900 font-outfit">Autentikasi & Header Format</h2>
        <p class="text-xs text-slate-500 font-sans">Metode pengiriman kredensial API Key yang didukung oleh server PutzPay.</p>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
      Setiap permintaan ke API wajib menyertakan kredensial <strong>API Key</strong> pengguna yang valid. Anda dapat memilih salah satu dari metode pengiriman di bawah ini:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
      <!-- Method 1: HTTP Header (RECOMMENDED) -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg sm:rounded-2xl p-4 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-900 font-sans">1. HTTP Header Standard</span>
          <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-mono font-semibold text-[10px]">DIREKOMENDASIKAN</span>
        </div>
        <p class="text-xs text-slate-500">Sertakan header <code>x-apikey</code> beserta header format <code>Accept</code>:</p>
        <div class="bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-xs space-y-1 border border-slate-800">
          <div><span class="text-blue-400">x-apikey:</span> <span class="text-emerald-300">YOUR_API_KEY</span></div>
          <div><span class="text-blue-400">Accept:</span> <span class="text-emerald-300">application/json</span></div>
        </div>
      </div>

      <!-- Method 2: URL Query Parameter -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg sm:rounded-2xl p-4 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-900 font-sans">2. URL Query Parameter</span>
          <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 font-mono font-semibold text-[10px]">GET / POST</span>
        </div>
        <p class="text-xs text-slate-500">Sertakan parameter <code>apikey</code> secara langsung pada URL query String:</p>
        <div class="bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-xs border border-slate-800 break-all">
          <span class="text-slate-400">https://putzpay.biz.id/api/endpoint</span><span class="text-amber-300">?apikey=YOUR_API_KEY</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2: DAFTAR ENDPOINT API -->
  <div class="space-y-6 w-full min-w-0">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 pb-1">
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center font-bold text-sm font-mono shrink-0">2</div>
        <div>
          <h2 class="text-base sm:text-lg lg:text-xl lg:text-2xl font-bold text-slate-900 font-outfit">Daftar Lengkap Endpoint API</h2>
          <p class="text-xs text-slate-500 font-sans">7 endpoint utama terintegrasi untuk seluruh kebutuhan sistem transaksi bisnis Anda.</p>
        </div>
      </div>
    </div>

    <!-- ENDPOINT 1: POST /api/balance -->
    <div id="endpoint-balance" class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-sm sm:shadow-card hover:shadow-card-hover sm:shadow-card-hover transition-all space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 pb-4 border-b border-slate-100">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <span class="px-2.5 py-1 rounded-xl bg-blue-50 text-blue-700 text-xs font-mono font-bold border border-blue-200">POST</span>
          <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 text-[10px] font-mono">GET support</span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-mono tracking-tight truncate">/api/balance</h3>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button onclick="openRequestModal('POST', '/api/balance', 'Cek Saldo (Balance)')" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-3.5 py-2 rounded-xl shadow-xs active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-code text-xs"></i>
            <span>Lihat Code</span>
          </button>
          <button onclick="openResponseModal('POST /api/balance', balanceResponseExample)" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3.5 py-2 rounded-xl active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-brackets-curly text-xs"></i>
            <span>Contoh Response</span>
          </button>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
        Mendapatkan informasi sisa saldo aktif akun pengguna secara real-time dari database PutzPay.
      </p>

      <div class="bg-blue-50/70 border border-blue-200/60 rounded-xl p-3 text-xs text-blue-900 flex items-center gap-1.5 sm:gap-2 font-sans">
        <i class="fa-solid fa-circle-info text-blue-600 text-sm shrink-0"></i>
        <span><strong>Legacy Support:</strong> Endpoint ini juga mendukung metode <code>GET</code> untuk menjaga kompatibilitas dengan integrasi lama.</span>
      </div>

      <!-- Headers Table -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider font-mono block">Headers</span>
        <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden overflow-x-auto">
          <table class="w-full text-left text-xs min-w-[360px]">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[11px]">
              <tr>
                <th class="p-3">Header</th>
                <th class="p-3">Required</th>
                <th class="p-3">Keterangan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">x-apikey</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[10px]">Opsional*</span></td>
                <td class="p-3">API Key pengguna (*Wajib jika tidak dikirimkan via body / query parameter)</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">Accept</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono text-[10px]">YA</span></td>
                <td class="p-3"><code>application/json</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ENDPOINT 2: POST /api/create/qris -->
    <div id="endpoint-create-qris" class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-sm sm:shadow-card hover:shadow-card-hover sm:shadow-card-hover transition-all space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 pb-4 border-b border-slate-100">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <span class="px-2.5 py-1 rounded-xl bg-blue-50 text-blue-700 text-xs font-mono font-bold border border-blue-200">POST</span>
          <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 text-[10px] font-mono">GET support</span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-mono tracking-tight truncate">/api/create/qris</h3>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button onclick="openRequestModal('POST', '/api/create/qris', 'Buat QRIS / Invoice', { amount: 50000 })" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-3.5 py-2 rounded-xl shadow-xs active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-code text-xs"></i>
            <span>Lihat Code</span>
          </button>
          <button onclick="openResponseModal('POST /api/create/qris', createQrisResponseExample)" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3.5 py-2 rounded-xl active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-brackets-curly text-xs"></i>
            <span>Contoh Response</span>
          </button>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
        Membuat invoice transaksi baru secara otomatis lengkap dengan payload string QRIS Dinamis dan tautan gambar QR code yang siap di-scan pelanggan.
      </p>

      <!-- Headers Table -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider font-mono block">Headers</span>
        <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden overflow-x-auto">
          <table class="w-full text-left text-xs min-w-[360px]">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[11px]">
              <tr>
                <th class="p-3">Header</th>
                <th class="p-3">Required</th>
                <th class="p-3">Keterangan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">x-apikey</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[10px]">Opsional*</span></td>
                <td class="p-3">API Key pengguna</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">Content-Type</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono text-[10px]">YA</span></td>
                <td class="p-3"><code>application/json</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Body Parameter Table -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider font-mono block">Parameters (Body JSON / Query)</span>
        <div class="border border-slate-200 rounded-lg sm:rounded-2xl overflow-hidden overflow-x-auto">
          <table class="w-full text-left text-xs min-w-[420px]">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[11px]">
              <tr>
                <th class="p-3">Parameter</th>
                <th class="p-3">Type</th>
                <th class="p-3">Required</th>
                <th class="p-3">Keterangan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">amount / nominal</td>
                <td class="p-3 font-mono text-slate-500">number</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200 font-mono text-[10px]">YA</span></td>
                <td class="p-3">Nominal pembayaran (misal: <code>50000</code>)</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 font-mono font-semibold text-blue-600">apikey</td>
                <td class="p-3 font-mono text-slate-500">string</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[10px]">Opsional</span></td>
                <td class="p-3">API Key (bisa dikirim via header, body, atau query)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ENDPOINT 3: POST /api/invoice/status -->
    <div id="endpoint-invoice-status" class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 sm:p-7 shadow-sm sm:shadow-card hover:shadow-card-hover sm:shadow-card-hover transition-all space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 pb-4 border-b border-slate-100">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <span class="px-2.5 py-1 rounded-xl bg-blue-50 text-blue-700 text-xs font-mono font-bold border border-blue-200">POST</span>
          <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 text-[10px] font-mono">GET support</span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-mono tracking-tight truncate">/api/invoice/status</h3>
