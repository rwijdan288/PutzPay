<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover">
  <title>Akses Dibatasi - <%= (typeof settings !== 'undefined' && settings.name) ? settings.name : 'PutzPay' %></title>
  
  <% if (typeof settings !== 'undefined' && settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/style.css">

  <script>
    tailwind.config = { 
      theme: { 
        extend: { 
          fontFamily: { 
            'sans': ['Plus Jakarta Sans', 'sans-serif'],
            'outfit': ['Outfit', 'sans-serif'],
            'mono': ['JetBrains Mono', 'monospace']
          },
          boxShadow: {
            'card': '0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01)',
            'btn': '0 4px 14px 0 rgba(37, 99, 235, 0.25)'
          }
        } 
      } 
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex items-center justify-center p-4 font-sans">

  <div class="w-full max-w-md mx-auto">
    <!-- Brand Header -->
    <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6">
      <% if (typeof settings !== 'undefined' && settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="Logo" class="w-10 h-10 rounded-xl object-cover border border-slate-200 shadow-xs" />
      <% } else { %>
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg shadow-xs">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
      <% } %>
      <div class="flex flex-col">
        <span class="font-outfit font-bold text-slate-900 text-xl tracking-tight leading-tight"><%= (typeof settings !== 'undefined' && settings.name) ? settings.name : 'PutzPay' %></span>
        <span class="text-[11px] font-mono text-slate-400">Access Restriction Notice</span>
      </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm sm:shadow-card space-y-6">
      
      <!-- Top Alert Badge -->
      <div class="flex items-center justify-center">
        <div class="w-16 h-16 rounded-lg sm:rounded-2xl bg-amber-50 border border-amber-200/60 flex items-center justify-center text-amber-600 text-2xl shadow-xs">
          <i class="fa-solid fa-shield-slash"></i>
        </div>
      </div>

      <!-- Title & Explanation -->
      <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold border border-amber-200/60">
          <i class="fa-solid fa-shield-slash text-xs"></i>
          <span>Global Access Block</span>
        </div>
        <h1 class="text-base sm:text-lg lg:text-xl lg:text-2xl font-bold tracking-tight text-slate-900 font-outfit">
          Akses Dibatasi
        </h1>
        <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
          <%= (typeof message !== 'undefined' && message) ? message : (typeof settings !== 'undefined' && settings.globalBlockMessage ? settings.globalBlockMessage : 'PutzPay sedang membatasi akses website untuk sementara waktu. Silakan coba kembali nanti.') %>
        </p>
      </div>

      <!-- Info Box -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg sm:rounded-2xl p-4 sm:p-5 space-y-2 text-center">
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 text-xs font-semibold text-slate-700">
          <i class="fa-solid fa-circle-info text-blue-600"></i>
          <span>Pusat Bantuan & Layanan Pelanggan</span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Jika Anda membutuhkan informasi transaksi atau bantuan mendesak, Customer Service resmi kami tetap beroperasi 24 jam nonstop.
        </p>
      </div>

      <!-- Primary Customer Service Action -->
      <% const csUrl = (typeof settings !== 'undefined' && settings.customerServiceUrl) ? settings.customerServiceUrl : 'https://cs.putzpay.biz.id'; %>
      <div class="space-y-3 pt-1">
        <a href="<%= csUrl %>" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-1.5 sm:gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-semibold shadow-btn transition-all cursor-pointer active:scale-95 font-outfit">
          <i class="fa-solid fa-comments text-xs"></i>
          <span>Hubungi Customer Service</span>
        </a>

        <button onclick="window.location.reload()" class="w-full inline-flex items-center justify-center gap-1.5 sm:gap-2 px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-xl text-xs font-semibold transition-all cursor-pointer active:scale-95">
          <i class="fa-solid fa-rotate-right text-xs"></i>
          <span>Periksa Ulang Akses</span>
        </button>

        <div class="pt-2 text-center">
          <a href="/login" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-slate-700 transition-colors font-medium">
            <i class="fa-solid fa-lock text-[10px]"></i>
            <span>Login Administrator / Petugas</span>
          </a>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="text-center pt-2 border-t border-slate-100">
        <p class="text-[11px] font-medium text-slate-400 font-mono">
          &copy; <%= new Date().getFullYear() %> <%= (typeof settings !== 'undefined' && settings.name) ? settings.name : 'PutzPay' %> &bull; All Rights Reserved
        </p>
      </div>

    </div>
  </div>

</body>
</html>
