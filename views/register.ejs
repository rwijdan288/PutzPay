<%- include('partials/header', { title: 'Daftar Akun PutzPay' }) %>

<div class="min-h-screen sm:min-h-[75vh] flex flex-col items-center justify-center py-8 sm:py-12 px-3 sm:px-4">
  
  <div class="w-full max-w-md bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-5 sm:p-7 md:p-9 shadow-card relative animate-fade-in">

    <!-- Logo / Title -->
    <div class="text-center mb-5 sm:mb-6">
      <% if (settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="PutzPay Logo" class="w-12 sm:w-14 h-12 sm:h-14 rounded-xl sm:rounded-2xl object-cover mx-auto mb-2 sm:mb-3 border border-slate-200 shadow-xs">
      <% } else { %>
        <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-lg sm:rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center text-base sm:text-lg mx-auto mb-2 sm:mb-3 shadow-xs flex-shrink-0">
          <i class="fa-solid fa-user-plus text-sm sm:text-base"></i>
        </div>
      <% } %>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[10px] sm:text-[11px] font-semibold border border-blue-100 mb-2">
        <i class="fa-solid fa-shield-halved text-[9px] sm:text-[10px]"></i>
        <span>Pendaftaran Resmi PutzPay</span>
      </div>
      <h2 class="text-lg sm:text-2xl font-bold text-slate-900 tracking-tight font-outfit mb-0.5 sm:mb-1">Buat Akun PutzPay</h2>
      <p class="text-[11px] sm:text-xs text-slate-500 font-sans">Mulai terima pembayaran QRIS & transaksi otomatis</p>
    </div>

    <!-- Alert Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-800 px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg sm:rounded-2xl mb-4 sm:mb-5 text-xs font-semibold flex items-start gap-2 sm:gap-3 shadow-xs">
        <i class="fas fa-exclamation-circle text-rose-600 text-sm shrink-0 mt-0.5"></i>
        <p class="leading-snug"><%= error %></p>
      </div>
    <% } %>

    <!-- Form Register -->
    <form method="POST" action="/register" id="registerForm" class="flex flex-col gap-3 sm:gap-3.5" autocomplete="off">
      
      <!-- 1. Nama Lengkap (WAJIB) -->
      <div>
        <label for="fullNameInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5">
          Nama Lengkap <span class="text-rose-500">*</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon absolute left-3 sm:left-3.5 pointer-events-none text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <input id="fullNameInput" name="fullName" type="text" placeholder="Masukkan nama lengkap" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-3 sm:pr-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" 
                 maxlength="60" required>
        </div>
      </div>

      <!-- 2. Username (WAJIB) -->
      <div>
        <label for="usernameInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5">
          Username <span class="text-rose-500">*</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon absolute left-3 sm:left-3.5 pointer-events-none text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
            </svg>
          </div>
          <input id="usernameInput" name="username" type="text" placeholder="Masukkan username" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-3 sm:pr-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" 
                 maxlength="15" minlength="4" pattern="[a-zA-Z0-9]+" title="Username 4-15 karakter, hanya huruf dan angka" required>
        </div>
        <div id="usernameStatus" class="mt-1 text-[10px] sm:text-[11px] font-mono min-h-[16px] px-1"></div>
      </div>

      <!-- 3. Telegram ID (OPSIONAL) -->
      <div>
        <label for="telegramIdInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5 flex items-center justify-between gap-2">
          <span>Telegram ID</span>
          <span class="text-[9px] sm:text-[10px] text-slate-400 font-normal flex-shrink-0">Opsional</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon absolute left-3 sm:left-3.5 pointer-events-none text-slate-400" aria-hidden="true">
            <i class="fa-brands fa-telegram text-sm"></i>
          </div>
          <input id="telegramIdInput" name="telegramId" type="text" placeholder="Masukkan Telegram ID (Opsional)" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-3 sm:pr-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" 
                 maxlength="50">
        </div>
      </div>

      <!-- 4. Email (WAJIB) -->
      <div>
        <label for="emailInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5">
          Alamat Email <span class="text-rose-500">*</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon absolute left-3 sm:left-3.5 pointer-events-none text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <input id="emailInput" name="email" type="email" placeholder="Masukkan alamat email" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-3 sm:pr-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" required>
        </div>
        <div id="emailStatus" class="mt-1 text-[10px] sm:text-[11px] font-mono min-h-[16px] px-1"></div>
      </div>

      <!-- 5. Nomor WhatsApp/HP (OPSIONAL) -->
      <div>
        <label for="phoneNumberInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5 flex items-center justify-between gap-2">
          <span>Nomor WhatsApp/HP</span>
          <span class="text-[9px] sm:text-[10px] text-slate-400 font-normal flex-shrink-0">Opsional</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon absolute left-3 sm:left-3.5 pointer-events-none text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <input id="phoneNumberInput" name="phoneNumber" type="tel" placeholder="Masukkan nomor WhatsApp/HP (Opsional)" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-3 sm:pr-4 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" 
                 maxlength="20">
        </div>
      </div>
      
      <!-- 6. Password (WAJIB) -->
      <div>
        <label for="passwordInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5">
          Password <span class="text-rose-500">*</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon password-icon absolute left-3 sm:left-3.5 pointer-events-none z-10 text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <input id="passwordInput" name="password" type="password" placeholder="Masukkan password" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-10 sm:pr-11 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" minlength="6" required>
          <button type="button" onclick="togglePasswordVisibility('passwordInput', 'togglePasswordIcon')" class="absolute right-2.5 sm:right-3.5 w-7 h-7 text-slate-400 hover:text-slate-700 transition-colors flex items-center justify-center cursor-pointer z-10 flex-shrink-0" aria-label="Tampilkan atau sembunyikan password">
            <span id="togglePasswordIcon" class="flex items-center justify-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
          </button>
        </div>
      </div>

      <!-- 7. Konfirmasi Password (WAJIB) -->
      <div>
        <label for="confirmPasswordInput" class="block text-xs font-semibold text-slate-700 mb-1.5 px-0.5">
          Konfirmasi Password <span class="text-rose-500">*</span>
        </label>
        <div class="relative flex items-center">
          <div class="input-icon password-icon absolute left-3 sm:left-3.5 pointer-events-none z-10 text-slate-400" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <input id="confirmPasswordInput" name="confirmPassword" type="password" placeholder="Konfirmasi password" 
                 class="w-full bg-white border border-slate-300 rounded-lg sm:rounded-xl pl-9 sm:pl-10 pr-10 sm:pr-11 py-2.5 text-xs font-sans font-medium text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" required>
          <button type="button" onclick="togglePasswordVisibility('confirmPasswordInput', 'toggleConfirmIcon')" class="absolute right-2.5 sm:right-3.5 w-7 h-7 text-slate-400 hover:text-slate-700 transition-colors flex items-center justify-center cursor-pointer z-10 flex-shrink-0" aria-label="Tampilkan atau sembunyikan password">
            <span id="toggleConfirmIcon" class="flex items-center justify-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </span>
          </button>
        </div>
        <div id="confirmPasswordStatus" class="mt-1 text-[10px] sm:text-[11px] font-mono min-h-[16px] px-1"></div>
      </div>

      <!-- 8. Cloudflare Turnstile -->
      <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
        <div class="turnstile-container my-0.5 sm:my-1 flex justify-center">
          <div class="cf-turnstile scale-90 sm:scale-100 origin-top" data-sitekey="<%= turnstileSiteKey %>" data-theme="light"></div>
        </div>
      <% } %>

      <!-- Tombol Daftar -->
      <button id="submitBtn" type="submit" class="bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white w-full py-2.5 sm:py-3 rounded-lg sm:rounded-xl text-xs font-bold font-sans uppercase shadow-btn transition-all flex items-center justify-center gap-2 mt-1 sm:mt-1.5 active:scale-95 cursor-pointer">
        <i class="fa-solid fa-user-check text-xs"></i>
        <span>Daftar Akun PutzPay Sekarang</span>
      </button>
    </form>

    <!-- Divider ATAU -->
    <div class="my-4 sm:my-5 flex items-center justify-center gap-3">
      <div class="h-px bg-slate-200 flex-1"></div>
      <span class="text-[10px] sm:text-[11px] font-semibold text-slate-400 flex-shrink-0">ATAU</span>
      <div class="h-px bg-slate-200 flex-1"></div>
    </div>

    <!-- Tombol Daftar Dengan Google -->
    <a href="/auth/google?intent=register" 
       target="_top"
       class="w-full h-10 sm:h-11 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-lg sm:rounded-xl text-xs font-semibold font-sans tracking-wide shadow-xs transition-all flex items-center justify-center gap-2 sm:gap-2.5 active:scale-95 cursor-pointer select-none">
      <svg class="w-4 h-4 shrink-0 block" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.62z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span>Daftar dengan Google</span>
    </a>

    <!-- Link Login -->
    <p class="mt-5 sm:mt-6 text-center text-xs text-slate-500 border-t border-slate-100 pt-4 sm:pt-5">
      Sudah memiliki akun? 
      <a href="/login" class="text-blue-600 font-bold hover:underline">Masuk Sekarang</a>
    </p>

    <!-- Security & Legal Notice -->
    <div class="mt-3 sm:mt-4 pt-2.5 sm:pt-3 border-t border-slate-100 text-center">
      <p class="text-[10px] sm:text-[11px] text-slate-400 flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-[9px] sm:text-[10px] text-emerald-600 flex-shrink-0"></i>
        <span>Koneksi Aman SSL 256-bit Terenkripsi • PutzPay</span>
      </p>
    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.innerHTML = `<svg class="w-4 h-4 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;
    } else {
      input.type = 'password';
      icon.innerHTML = `<svg class="w-4 h-4 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
    }
  }

  const registerForm = document.getElementById('registerForm');
  const fullNameInput = document.getElementById('fullNameInput');
  const usernameInput = document.getElementById('usernameInput');
  const emailInput = document.getElementById('emailInput');
  const passwordInput = document.getElementById('passwordInput');
  const confirmPasswordInput = document.getElementById('confirmPasswordInput');
  const confirmPasswordStatus = document.getElementById('confirmPasswordStatus');
  const usernameStatus = document.getElementById('usernameStatus');
  const emailStatus = document.getElementById('emailStatus');
  const submitBtn = document.getElementById('submitBtn');

  let usernameCheckTimer;
  let emailCheckTimer;

  function validatePasswords() {
    const p1 = passwordInput ? passwordInput.value : '';
    const p2 = confirmPasswordInput ? confirmPasswordInput.value : '';
    if (!p2) {
      if (confirmPasswordStatus) confirmPasswordStatus.innerHTML = '';
      return true;
    }
    if (p1 !== p2) {
      if (confirmPasswordStatus) confirmPasswordStatus.innerHTML = '<span class="text-rose-600 font-semibold">✗ Konfirmasi password tidak cocok.</span>';
      return false;
    } else {
      if (confirmPasswordStatus) confirmPasswordStatus.innerHTML = '<span class="text-emerald-600 font-semibold">✓ Password cocok</span>';
      return true;
    }
  }

  if (passwordInput && confirmPasswordInput) {
    passwordInput.addEventListener('input', validatePasswords);
    confirmPasswordInput.addEventListener('input', validatePasswords);
  }

  async function checkAvailability(type, value, statusEl) {
    if (!value) {
      if (statusEl) statusEl.innerHTML = '';
      updateSubmitButton();
      return;
    }

    if (type === 'username' && value.length < 4) {
      if (statusEl) statusEl.innerHTML = '<span class="text-slate-400">Minimal 4 karakter</span>';
      updateSubmitButton();
      return;
    }

    try {
      const res = await fetch('/check-availability', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, value })
      });
      const data = await res.json();
      if (data.available) {
        if (statusEl) statusEl.innerHTML = `<span class="text-emerald-600 font-semibold">✓ ${data.message}</span>`;
      } else {
        if (statusEl) statusEl.innerHTML = `<span class="text-rose-600 font-semibold">✗ ${data.message}</span>`;
      }
    } catch (err) {
      if (statusEl) statusEl.innerHTML = `<span class="text-slate-400">⚠ Tidak dapat memeriksa</span>`;
    }
    updateSubmitButton();
  }

  function updateSubmitButton() {
    const usernameText = usernameStatus ? usernameStatus.textContent : '';
    const emailText = emailStatus ? emailStatus.textContent : '';
    const usernameInvalid = usernameText.includes('tidak valid') ||
                            usernameText.includes('sudah digunakan') ||
                            usernameText.includes('Minimal 4 karakter');
    const emailInvalid = emailText.includes('tidak valid') ||
                         emailText.includes('sudah terdaftar');
    if (submitBtn) {
      submitBtn.disabled = (usernameInvalid || emailInvalid);
    }
  }

  if (usernameInput) {
    usernameInput.addEventListener('input', function() {
      this.value = this.value.toLowerCase().replace(/[^a-zA-Z0-9]/g, '');
      clearTimeout(usernameCheckTimer);
      const val = this.value.trim();
      usernameCheckTimer = setTimeout(() => checkAvailability('username', val, usernameStatus), 400);
    });
  }

  if (emailInput) {
    emailInput.addEventListener('input', function() {
      clearTimeout(emailCheckTimer);
      const val = this.value.trim();
      if (val && /^\S+@\S+\.\S+$/.test(val)) {
        emailCheckTimer = setTimeout(() => checkAvailability('email', val, emailStatus), 400);
      } else {
        if (emailStatus) emailStatus.innerHTML = val ? '<span class="text-slate-400">Format email tidak valid</span>' : '';
        updateSubmitButton();
      }
    });
  }

  if (registerForm) {
    registerForm.addEventListener('submit', function(e) {
      if (passwordInput && confirmPasswordInput && passwordInput.value !== confirmPasswordInput.value) {
        e.preventDefault();
        if (confirmPasswordStatus) confirmPasswordStatus.innerHTML = '<span class="text-rose-600 font-semibold">✗ Konfirmasi password tidak cocok.</span>';
        confirmPasswordInput.focus();
        return false;
      }
    });
  }
</script>

<%- include('partials/footer') %>
